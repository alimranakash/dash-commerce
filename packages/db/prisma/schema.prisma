  paymentStatus         PaymentStatus           @default(PENDING)
  verificationStatus    OrderVerificationStatus @default(NORMAL)
  paymentMethodType     PaymentMethodType       @default(COD)
  paymentMethodName     String                  @default("Cash on delivery")
  paymentReference      String?
  paymentNote           String?
  fulfillmentStatus     FulfillmentStatus       @default(UNFULFILLED)
  currency              String
  subtotalAmount        Decimal                 @db.Decimal(12, 2)
  shippingAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  shippingRateId        String?
  shippingRateName      String?
  shippingDistrict      String?
  shippingCity          String?
  shippingArea          String?
  discountAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  taxAmount             Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                 @db.Decimal(12, 2)
  customerName          String
  customerEmail         String?
  customerPhone         String
  shippingAddressId     String?
  billingAddressId      String?
  notes                 String?
  verifiedAt            DateTime?
  markedFakeAt          DateTime?
  /// Stored output of the rule-based risk engine (modules/fake-orders).
  /// Written whenever the order or its customer history changes, never on read.
  riskScore             Int                     @default(0)
