  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentGateway {
  SSLCOMMERZ
  STRIPE
  PADDLE
  MANUAL
  OTHER
}

enum PaymentMethodType {
  COD
  BKASH_MANUAL
  NAGAD_MANUAL
  ROCKET_MANUAL
}

/// Verification lifecycle for one order.
///
/// NORMAL         — assessed, not risky enough to review (or manually released).
/// PENDING_REVIEW — assessed as risky and waiting for a seller decision.
/// VERIFIED       — seller confirmed the order is real.
/// FAKE           — seller rejected the order.
/// BLOCKED        — seller rejected the order and blocked the customer.
///
/// QUEUED is a legacy value that no code path ever wrote. It is kept so the
/// enum stays additive, and is read as PENDING_REVIEW everywhere.
enum OrderVerificationStatus {
  NORMAL
  QUEUED
  PENDING_REVIEW
  VERIFIED
  FAKE
  BLOCKED
}

enum OrderRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CustomerFlagStatus {
  NORMAL
  WATCHLIST
  BLOCKED
}

enum AbandonedCartStatus {
  NOT_CONTACTED
  CONTACTED
  RECOVERED
}

/**
 * How far down the funnel a snapshot got before it stopped.
 *
 * CART is a cart that was never carried into checkout; the two CHECKOUT_ values
 * are what the dashboard calls an incomplete order — the shopper filled the
 * checkout form, and either walked away from it or pressed Place Order and was
 * refused. A snapshot only ever moves forward through these.
 */
enum AbandonedCartStage {
  CART
  CHECKOUT_STARTED
  CHECKOUT_FAILED
}

