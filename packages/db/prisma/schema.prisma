  country                    String                      @default("US")
  timezone                   String                      @default("UTC")
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains                    StoreDomain[]
  products                   Product[]
  categories                 Category[]
  orders                     Order[]
  customers                  Customer[]
  addresses                  Address[]
  setting                    StoreSetting?
  messagingSetting           StoreMessagingSetting?
  themeSetting               ThemeSetting?
  marketingSetting           MarketingSetting?
  orderBump                  OrderBump?
  bundles                    Bundle[]
  paymentMethods             PaymentMethod[]
  shippingZones              ShippingZone[]
  shippingRates              ShippingRate[]
  storeosConnection          StoreOSConnection?
  apiKeys                    StoreApiKey[]
  mediaAssets                MediaAsset[]
  purchases                  Purchase[]
  expenses                   Expense[]
  sales                      Sale[]
  stockMovements             StockMovement[]
  subscription               Subscription?
  payments                   Payment[]
  supportTickets             SupportTicket[]
  systemLogs                 SystemLog[]
  courierAccounts            CourierAccount[]
  shipments                  Shipment[]
  deliveryEvents             DeliveryEvent[]
  courierCustomerScores      CourierCustomerScore[]
  productTaxonomies          ProductTaxonomy[]
  productTaxonomyAssignments ProductTaxonomyAssignment[]
  productCategoryAssignments ProductCategoryAssignment[]
  productAttributes          ProductAttribute[]
  productAttributeValues     ProductAttributeValue[]
  productVariants            ProductVariant[]
  productRelations           ProductRelation[]
  productContents            ProductContent[]
  aiSetting                  StoreAiSetting?
  salesNotificationSetting   StoreSalesNotificationSetting?
  notificationBar            StoreNotificationBar?
  freeShipping               StoreFreeShipping?
  abandonedCarts             AbandonedCart[]
  searchSynonyms             SearchSynonym[]
  searchBoosts               SearchBoost[]
