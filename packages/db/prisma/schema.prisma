/// How one product is meant to sell another.
///
/// UPSELL is the same need at a higher price - the 128GB phone shown on the
/// 64GB one. CROSS_SELL is a different product bought on the same trip, and
/// ACCESSORY is the narrow case of one that only makes sense alongside this
/// product. They are kept apart because the surfaces spend them differently:
/// an upsell asks the shopper to swap, a cross-sell asks them to add.
enum ProductRelationType {
  UPSELL
  CROSS_SELL
  ACCESSORY
}

enum OrderBumpDiscountType {
  /// Percent off the product's own price.
  PERCENTAGE
  /// Flat amount off it.
  FIXED
}

/// Which surface put a line into an order.
///
/// The order is one basket by the time anyone looks at it, so without this
/// nobody can say what the merchandising actually earned — a cross-sell that
/// worked and a product the shopper went looking for are the same row.
///
/// CART is the honest default for everything that was simply added, including
/// every line written before this column existed.
enum OrderItemSource {
  CART
  /// One tap from the cross-sell rail in the cart or its drawer.
  CART_CROSS_SELL
  /// The tick box above Place Order.
  ORDER_BUMP
}

/// What shape of deal a bundle is.
///
/// The two are genuinely different questions about a cart, which is why they
/// are one enum and not two booleans: SET asks "are all of these here", and
/// QUANTITY asks "how many of any of these are here".
enum BundleType {
  /// Every listed product, at its listed quantity, present together.
  SET
  /// N units drawn from the listed products, of which M are discounted.
  QUANTITY
}

enum BundleDiscountType {
  /// Percent off the qualifying units. 100 makes them free.
  PERCENTAGE
  /// Flat amount off, per time the bundle applies.
  FIXED
}

enum BundleStatus {
  ACTIVE
  INACTIVE
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
