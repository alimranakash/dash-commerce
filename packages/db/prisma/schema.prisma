model ShippingRate {
  id        String       @id @default(cuid())
  storeId   String
  zoneId    String
  name      String
  district  String?
  city      String?
  area      String?
  amount    Decimal      @db.Decimal(12, 2)
  isEnabled Boolean      @default(true)
  sortOrder Int          @default(0)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([storeId])
  @@index([zoneId])
}

model StoreOSConnection {
  id                  String    @id @default(cuid())
  storeId             String    @unique
  storeosConnectionId String?   @unique
  platformType        String    @default("dash")
  status              String    @default("pending")
  capabilities        Json
  lastSyncedAt        DateTime?
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([status])
}

/// A machine-to-machine credential for the external AI API (`/api/ai/v1/**`).
///
/// The raw key is shown to the seller exactly once, when it is issued, and is
/// never written anywhere: only `tokenHash` reaches the database. A dump, a
/// backup, or a screenshot of this table therefore yields nothing that can be
/// replayed — the same reasoning as `StaffInvite.tokenHash`.
///
/// One key resolves to exactly one store. The key *is* the tenant identity:
/// nothing a caller sends in a query string, a body, or a header may override
/// the `storeId` on this row.
model StoreApiKey {
  id         String    @id @default(cuid())
  storeId    String
  /// Seller-facing label, so two keys can be told apart in settings.
  name       String
  /// SHA-256 of the raw key, hex. Unique because authentication is a single
  /// indexed equality lookup — plain SHA-256 rather than a password hash on
  /// purpose: the input is 256 random bits, so there is no dictionary to slow
  /// down.
  tokenHash  String    @unique
  /// Last four characters of the raw key. Enough to prove which key is stored,
  /// useless on its own.
  hint       String
  /// AES-256-GCM ciphertext of the raw key (lib/secret-box.ts), so a seller can
  /// read their own key back instead of re-issuing it. Null on two paths, both
  /// harmless: a deployment with no encryption key set, and keys minted before
  /// this column existed. Such a key still authenticates — tokenHash is what
  /// authentication reads — it simply cannot be shown again.
  secretCipher String?
  /// Granted scopes, from the vocabulary in modules/ai/ai.schema.ts. Stored as
  /// plain strings rather than an enum so adding a scope is a code change, not a
  /// database migration.
  scopes     String[]
  /// Best-effort last-seen marker, written on successful authentication. Never
  /// read by an authorisation decision — it is there so a seller can tell a live
  /// key from a forgotten one.
  lastUsedAt DateTime?
  revokedAt  DateTime?
  expiresAt  DateTime?
  store      Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @default(now()) @updatedAt

  @@index([storeId])
}

model MediaAsset {
  id        String   @id @default(cuid())
  storeId   String
  url       String
  key       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String?
  usageType String?
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  isDemoContent Boolean @default(false)
  demoPackId    String?

  @@unique([storeId, key])
  @@index([storeId])
  @@index([usageType])
  @@index([storeId, isDemoContent])
}

model Product {
  id                  String                      @id @default(cuid())
  storeId             String
  categoryId          String?
  title               String
  slug                String
  description         String?
  shortDescription    String?
  sku                 String?
  price               Decimal                     @db.Decimal(12, 2)
  compareAtPrice      Decimal?                    @db.Decimal(12, 2)
  costPrice           Decimal?                    @db.Decimal(12, 2)
  stockQuantity       Int                         @default(0)
  lowStockThreshold   Int                         @default(0)
  /// Whether this product may be sold past its stock, and roughly when the
  /// buyer will get it.
  ///
  /// Stock is allowed to go negative for these: minus seven reads as "seven
  /// owed", which is what the seller has to buy and what the inventory pages
  /// are expected to show. The date is a promise made to the shopper, so it is
  /// shown wherever the pre-order badge is.
  allowPreorder       Boolean                     @default(false)
  preorderReleaseAt   DateTime?
  /// Whether buying this product earns free delivery on the whole order.
  ///
  /// Whole order, not this line: the shop charges one flat rate per order, so
  /// there is no per-item delivery to waive. It sits beside the store-wide
  /// threshold as a second way to qualify, and the same zone scope applies to
  /// both — a shop that cannot absorb Outside Dhaka cannot absorb it for one
  /// product either. Read by `ensureFreeShippingSchema` through raw SQL so a
  /// checkout on a client that predates this column still prices correctly.
  freeShipping        Boolean                     @default(false)
  status              ProductStatus               @default(DRAFT)
  visibility          ProductVisibility           @default(HIDDEN)
  isDemoContent       Boolean                     @default(false)
  demoPackId          String?
  store               Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  orderItems          OrderItem[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  taxonomyAssignments ProductTaxonomyAssignment[]
  categoryAssignments ProductCategoryAssignment[]
  attributes          ProductAttribute[]
  attributeValues     ProductAttributeValue[]
  variants            ProductVariant[]
  returnItems         OrderReturnItem[]
  returnReplacements  OrderReturnItem[]           @relation("OrderReturnReplacementProduct")
  relations           ProductRelation[]           @relation("ProductRelationSource")
  relatedFrom         ProductRelation[]           @relation("ProductRelationTarget")
  content             ProductContent?
  orderBumps          OrderBump[]
  bundleItems         BundleItem[]
  wishlistItems       WishlistItem[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now()) @updatedAt

  searchBoosts SearchBoost[]

  /// Storefront relevance index. Declared here only so `db:push` does not drop
  /// it; the real definition is the GENERATED ALWAYS expression in
  /// apps/web/src/modules/search/search-schema.ts, which Prisma cannot express.
  searchVector Unsupported("tsvector")?

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId])
  @@index([storeId, isDemoContent])
  @@index([storeId, demoPackId])
  @@index([categoryId])
  @@index([searchVector], type: Gin)
}

/// The store's own AI provider configuration.
///
/// Distinct from `StoreOSConnection`, which is the *platform's* link to the
/// central engine and carries no merchant credential. This row is the seller
/// bringing their own key: a Gemini or OpenAI key they pay for, encrypted with
/// `lib/secret-box.ts` and readable only on the server. The plaintext key never
/// leaves this process — the dashboard is sent `*hint` and nothing else.
///
/// `defaultProvider` picks between those keys and `storeos`, so a store that has
/// configured nothing still routes through StoreIM AI exactly as it did before.
model StoreAiSetting {
  id                 String   @id @default(cuid())
  storeId            String   @unique
  /// One of "storeos", "gemini", "openai". Validated by aiProviderSchema, kept
  /// as text so adding a provider is not a migration.
  defaultProvider    String   @default("storeos")
  geminiApiKeyCipher String?
  /// Last four characters, so settings can prove which key is stored.
  geminiApiKeyHint   String?
  geminiModel        String   @default("gemini-2.5-flash")
  openaiApiKeyCipher String?
  openaiApiKeyHint   String?
  openaiModel        String   @default("gpt-4o-mini")
  /// Defaults the Product Content Studio and the inline buttons start from, so
  /// a seller sets their register once instead of on every product.
  contentTone        String   @default("friendly")
  contentLanguage    String   @default("en")
  /// The seller's standing steer, prepended to every product-content request.
  brandVoice         String?
  /// Whether the AI Shopping Agent answers customers on this shop's storefront.
  ///
  /// Off until the seller turns it on, and deliberately not implied by holding a
  /// provider key: the other AI surfaces spend that key on the seller's own
  /// clicks, while this one spends it on public traffic and speaks to their
  /// customers in their shop's name. That is a decision only they can make.
  shoppingAgentEnabled Boolean @default(false)
  store              Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @default(now()) @updatedAt
}

/// How this shop shows recent purchases to its shoppers.
///
/// There is no event table beside this one, and that is the design: a card is
/// rendered from a real `Order` at read time, so there is nothing to seed, keep
/// in step, or quietly hand-edit into a purchase that never happened. This row
/// is only the seller's preferences about how much of a real order is repeated
/// in public and how often.
///
/// The table is also created at runtime by `ensureSalesNotificationSchema()`
/// (modules/sales-notifications/sales-notifications.repository.ts), because it
/// is read on every storefront page and must not depend on anyone having run
/// `db:generate`. This model mirrors that DDL exactly — including the custom
/// index name — so `db push` stays a no-op.
///
/// `nameDisplay` and `position` are TEXT rather than Postgres enums for the same
/// reason `ProductTaxonomy.type` is: the runtime DDL has to be idempotent and
/// `CREATE TYPE` is not. The allowed values live in
/// modules/sales-notifications/sales-notifications.schema.ts.
model StoreSalesNotificationSetting {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  /// Off until the seller asks for it. An entitled plan must never publish
  /// something on a storefront by itself.
  enabled             Boolean  @default(false)
  /// One of "first_name", "initial", "anonymous". Defaults to the middle one:
  /// the customers on these cards did not agree to appear on a shop's homepage.
  nameDisplay         String   @default("initial")
  /// Comma-separated `OrderStatus` values a card may be drawn from — every one
  /// of them by default, because a shop selling on delivery has most of its
  /// real sales sitting in PENDING for days. TEXT rather than an enum array so
  /// the runtime DDL stays idempotent, the same reason the columns either side
  /// of it are text.
  orderStatuses       String   @default("PENDING,CONFIRMED,PROCESSING,COMPLETED,CANCELLED")
  /// Whether a card is limited to products a shopper could still open and buy.
  /// Off by default: an order for a since-deleted product is still a real
  /// purchase, and it shows with the name it was sold under and no link.
  requirePublicProduct Boolean @default(false)
  /// One of "bottom-left", "bottom-right", "top-left", "top-right".
  position            String   @default("bottom-left")
  showLocation        Boolean  @default(true)
  showOnMobile        Boolean  @default(true)
  showProductImage    Boolean  @default(true)
  showTimeAgo         Boolean  @default(true)
  initialDelaySeconds Int      @default(8)
  displaySeconds      Int      @default(6)
  gapSeconds          Int      @default(18)
  /// Hard ceiling per visitor, after which the widget stops for the visit.
  maxPerSession       Int      @default(8)
  /// How old an order may be and still be announced. "Just purchased" over a
  /// three-month-old order is the same untruth as inventing one.
  lookbackDays        Int      @default(14)
  loopFeed            Boolean  @default(true)
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

/// The Floating Notification Bar — the shop's one announcement.
///
/// Created at request time by `ensureNotificationBarSchema()` in
/// modules/notification-bar/notification-bar.repository.ts, for the reason
/// `StoreSalesNotificationSetting` above is: it is read on every storefront page
/// of every shop, so it must exist on a database that has not re-run
/// `db:generate`. This model mirrors that DDL exactly — including the custom
/// index name — so `db push` stays a no-op.
///
/// `position` and `layout` are TEXT rather than Postgres enums for the same
/// reason: the runtime DDL has to be idempotent and `CREATE TYPE` is not. The
/// allowed values live in modules/notification-bar/notification-bar.schema.ts.
/// The store's free-shipping threshold, and the bar that announces it.
///
/// Created at request time by `ensureFreeShippingSchema()` in
/// modules/free-shipping/free-shipping.repository.ts, for the reason
/// `StoreSalesNotificationSetting` is: it is read on every cart, every mini cart
/// and every checkout, so it must exist on a database that has not re-run
/// `db:generate`. This model mirrors that DDL exactly.
///
/// The rule half (`enabled`, `threshold`, `zoneIds`) is what
/// `createCheckoutOrder` charges by. The bar half is only how it is announced,
/// and the schema refuses to switch the bar on without the rule — a progress bar
/// for an offer checkout does not honour is what this model replaced.
model StoreFreeShipping {
  id             String   @id @default(cuid())
  storeId        String   @unique
  /// Whether checkout actually waives the delivery charge. Off by default: the
  /// display-only settings this replaced shipped on at 250, so seeding from
  /// them would have made every shop start absorbing delivery it never agreed
  /// to. The migration turns the promise off, never the payment on.
  enabled        Boolean  @default(false)
  /// The qualifying cart subtotal, as a fixed-2 string so money never
  /// round-trips through a float. `0` means no offer.
  threshold      String   @default("0.00")
  /// Comma-separated `ShippingZone` ids the offer covers. Empty means every
  /// zone — a shop can afford Inside Dhaka at 70 and not Outside at 130.
  zoneIds        String   @default("")
  barEnabled     Boolean  @default(true)
  /// `{amount}` is replaced with the shortfall in the shop's currency.
  barText        String   @default("Add {amount} more to get FREE shipping")
  barSuccessText String   @default("You have earned free shipping.")
  /// Comma-separated surface names: "cart", "mini_cart", "product".
  surfaces       String   @default("cart,mini_cart")
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt
}

model StoreNotificationBar {
  id              String    @id @default(cuid())
  storeId         String    @unique
  /// Off until the seller asks for it. An entitled plan must never publish
  /// something on a storefront by itself.
  enabled         Boolean   @default(false)
  /// The big line — "20% OFF". A bar cannot be switched on without one.
  headline        String    @default("")
  /// The optional supporting line under it.
  message         String    @default("")
  ctaLabel        String    @default("")
  /// A storefront path, an in-page anchor, or an absolute http(s)/mailto/tel
  /// address. Narrowed by `isSafeBarHref` before it is ever stored, because it
  /// becomes an anchor on a public page.
  ctaHref         String    @default("")
  /// One of "top", "bottom". Bottom by default: the top of a storefront already
  /// carries the announcement strip, the header and the menu.
  position        String    @default("bottom")
  /// One of "floating", "edge".
  layout          String    @default("floating")
  /// Empty means the shop's own `--sf-primary`, so a new bar is already
  /// on-brand and follows a re-theme without being edited.
  backgroundColor String    @default("")
  textColor       String    @default("#ffffff")
  buttonColor     String    @default("#ffffff")
  /// Empty means the bar's own background — a white button with blue text on a
  /// blue bar.
  buttonTextColor String    @default("")
  showCountdown   Boolean   @default(true)
  showOnMobile    Boolean   @default(true)
  dismissible     Boolean   @default(true)
  /// How long an X is honoured for, in days. 0 means the one visit.
  dismissDays     Int       @default(1)
  /// One of "overlay", "inline". `overlay` is pinned to the viewport and mounted
  /// once from the storefront layout, so it follows the shopper across the whole
  /// shop and the four placement columns below do not apply to it. `inline` sits
  /// in a page's own flow at the anchor those columns name.
  display         String    @default("overlay")
  /// Comma-separated surface names — "home", "shop", "product", "other" — that
  /// an inline bar appears on. TEXT rather than an enum array so the runtime DDL
  /// stays idempotent, the same reason the three slot columns below are text.
  surfaces        String    @default("home,shop,product,other")
  /// One of "top", "after_hero", "after_first_section", "before_footer".
  homeSlot        String    @default("after_hero")
  /// One of "top", "above_grid", "in_grid", "before_footer".
  shopSlot        String    @default("above_grid")
  /// One of "top", "above_cart", "below_cart", "below_details".
  productSlot     String    @default("below_cart")
  /// How many product cards come before an "in_grid" bar.
  gridAfter       Int       @default(4)
  /// Before this, the storefront renders nothing at all — not markup hidden
  /// with CSS. A sale that opens on Friday is a thing sellers plan around.
  startsAt        DateTime?
  /// The countdown's target *and* the moment the bar comes down. One column for
  /// both, so a shop can never advertise a sale whose timer has run out.
  endsAt          DateTime?
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt
}

/// The product copy that has nowhere to sit on `Product`.
///
/// Highlights, the SEO trio, and the social caption are written by the AI
/// Product Content Studio and edited by the seller, but none of them is a
/// column the catalogue, the cart, or the storefront reads today — so they
/// live in a satellite row rather than widening the table every query in the
/// app selects from. Title, short description and description are deliberately
/// *not* here: those already exist on `Product` and the studio writes them
/// there, so there is never a second copy of a field the storefront renders.
///
/// `features` is one highlight per line and `keywords` is a comma-separated
/// list, which is how a seller types them into the textarea they are edited in.
model ProductContent {
  id              String    @id @default(cuid())
  storeId         String
  productId       String    @unique
  features        String?
  seoTitle        String?
  metaDescription String?
  keywords        String?
  socialCaption   String?
  /// Which engine wrote the last generated draft — "storeos" or "template".
  /// Recorded so a seller can be told what they are reading, and never used as
  /// a gate.
  lastSource      String?
  lastGeneratedAt DateTime?
  store           Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product         Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @default(now()) @updatedAt

  @@index([storeId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

/// A seller-chosen pairing between two products, read by the storefront rails
/// that sell one alongside the other.
///
/// Directional on purpose: pairing a phone with its case does not put the phone
/// on the case's page. A seller who wants both directions writes both rows.
///
/// `storeId` is carried here rather than reached through `product` so every
/// read is scoped the way the rest of the catalogue is, and so the ordering
/// index stays usable without a join.
model ProductRelation {
  id               String              @id @default(cuid())
  storeId          String
  productId        String
  relatedProductId String
  type             ProductRelationType
  /// The seller's ordering within one type; the storefront rails read in it.
  position         Int                 @default(0)
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product             @relation("ProductRelationSource", fields: [productId], references: [id], onDelete: Cascade)
  relatedProduct   Product             @relation("ProductRelationTarget", fields: [relatedProductId], references: [id], onDelete: Cascade)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  /// One pair may be both an upsell and a cross-sell, but not either twice.
  @@unique([productId, relatedProductId, type])
  @@index([storeId, productId, type])
  @@index([storeId, relatedProductId])
}

model Category {
  id                 String                      @id @default(cuid())
  storeId            String
  parentId           String?
  name               String
  slug               String
  description        String?
  imageUrl           String?
  isDemoContent      Boolean                     @default(false)
  demoPackId         String?
  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent             Category?                   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]                  @relation("CategoryHierarchy")
  products           Product[]
  productAssignments ProductCategoryAssignment[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, isDemoContent])
  @@index([storeId, demoPackId])
  @@index([parentId])
}

// The six models below back tables that are also created at runtime by
// ensureProductTaxonomySchema() and ensureProductVariantSchema(). They mirror
// that DDL exactly — including `onUpdate: NoAction` (the raw DDL omits an
// ON UPDATE clause) and the custom index names — so `db push` stays a no-op.

model ProductTaxonomy {
  id            String                      @id @default(cuid())
  storeId       String
  type          String
  name          String
  slug          String
  imageUrl      String?
  isDemoContent Boolean                     @default(false)
  demoPackId    String?
  store         Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments   ProductTaxonomyAssignment[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @default(now()) @updatedAt

  @@unique([storeId, type, slug], map: "ProductTaxonomy_store_type_slug_key")
  @@index([storeId, type], map: "ProductTaxonomy_store_type_idx")
}

model ProductTaxonomyAssignment {
  id         String          @id @default(cuid())
  storeId    String
  productId  String
  taxonomyId String
  type       String
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taxonomy   ProductTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime        @default(now())

  @@unique([productId, taxonomyId, type], map: "ProductTaxonomyAssignment_product_taxonomy_type_key")
  @@index([storeId, productId], map: "ProductTaxonomyAssignment_store_product_idx")
}

model ProductCategoryAssignment {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  categoryId String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId], map: "ProductCategoryAssignment_product_category_key")
  @@index([storeId, productId], map: "ProductCategoryAssignment_store_product_idx")
}

model ProductAttribute {
  id        String                  @id @default(cuid())
  storeId   String
  productId String
  name      String
  position  Int                     @default(0)
  store     Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  values    ProductAttributeValue[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @default(now()) @updatedAt

  @@index([storeId, productId], map: "ProductAttribute_store_product_idx")
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  storeId     String
  productId   String
  attributeId String
  name        String
  position    Int              @default(0)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([storeId, productId], map: "ProductAttributeValue_store_product_idx")
}

model ProductVariant {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  title             String
  optionSignature   String
  options           Json     @default("{}")
  sku               String?
  imageUrl          String?
  price             Decimal  @default(0) @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(0)
  continueSelling   Boolean  @default(false)
  status            String   @default("ACTIVE")
  position          Int      @default(0)
  barcode           String?
  weight            String?
  dimensions        String?
  taxClass          String?
  shippingClass     String?
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([productId, optionSignature], map: "ProductVariant_product_signature_key")
  @@index([storeId, productId], map: "ProductVariant_store_product_idx")
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  companyName    String?        @map("company_name")
  phone          String
  email          String?
  address        String?
  notes          String?
  status         SupplierStatus @default(ACTIVE)
