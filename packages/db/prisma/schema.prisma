/// Verification lifecycle for one order.
///
/// NORMAL         — assessed, not risky enough to review (or manually released).
/// PENDING_REVIEW — assessed as risky and waiting for a seller decision.
/// VERIFIED       — seller confirmed the order is real.
/// FAKE           — seller rejected the order.
/// BLOCKED        — seller rejected the order and blocked the customer.
///
/// QUEUED is a legacy value that no code path ever wrote. It is kept so the
/// enum stays additive, and is read as PENDING_REVIEW everywhere.
enum OrderVerificationStatus {
  NORMAL
  QUEUED
  PENDING_REVIEW
  VERIFIED
  FAKE
  BLOCKED
}

enum OrderRiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum CustomerFlagStatus {
  NORMAL
  WATCHLIST
  BLOCKED
}

enum AbandonedCartStatus {
