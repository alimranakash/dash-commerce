model Customer {
  id             String             @id @default(cuid())
  storeId        String
  name           String
  email          String?
  phone          String
  flagStatus     CustomerFlagStatus @default(NORMAL)
  /// Marketing consent, per channel. Transactional messages — order
  /// confirmations, delivery updates, verification codes — ignore these
  /// entirely; opting out of promotions is not opting out of being told where
  /// your parcel is. Only campaign sends read them.
  ///
  /// Present from the first campaign rather than added later on purpose: a
  /// campaign that already went out cannot retroactively have respected a
  /// column that did not exist when it ran.
  marketingSmsOptOut   Boolean        @default(false)
  marketingEmailOptOut Boolean        @default(false)
  store          Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders         Order[]
  sales          Sale[]
  addresses      Address[]
  abandonedCarts AbandonedCart[]
  returns        OrderReturn[]
  campaignRecipients CampaignRecipient[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @default(now()) @updatedAt

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([flagStatus])
}

/// One store's IP blocklist.
///
/// Per store on purpose: an address abusing one shop is not thereby abusing the
/// platform, and no seller should be able to lock a shopper out of somebody
/// else's storefront. Enforced at order placement only — see
/// `modules/blocked-ips/blocked-ip.enforcement.ts`.
model BlockedIp {
  id        String    @id @default(cuid())
  storeId   String
  /// Normalised by `normaliseIpAddress` before every read and write — lower
  /// cased, IPv6 collapsed to its canonical short form — so the unique index
  /// below actually holds and a lookup cannot miss on spelling alone.
  ipAddress String
  reason    String?
  /// Null blocks forever. A dated block is how a seller undoes a mistake they
  /// have not noticed yet, which matters more here than it looks: carrier-grade
  /// NAT means one address can be thousands of unrelated shoppers.
  expiresAt DateTime?
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([storeId, ipAddress])
  @@index([storeId])
  @@index([storeId, expiresAt])
}

model Address {
  id             String    @id @default(cuid())
  storeId        String
  customerId     String?
  name           String
  phone          String
  email          String?
  country        String
  district       String
  city           String?
  area           String?
  addressLine1   String
  addressLine2   String?
  postalCode     String?
  store          Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer       Customer? @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingOrders Order[]   @relation("OrderShippingAddress")
  billingOrders  Order[]   @relation("OrderBillingAddress")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @default(now()) @updatedAt

  @@index([storeId])
  @@index([customerId])
}

model Order {
  id                    String                  @id @default(cuid())
  storeId               String
  customerId            String?
  orderNumber           String
  status                OrderStatus             @default(PENDING)
  paymentStatus         PaymentStatus           @default(PENDING)
  verificationStatus    OrderVerificationStatus @default(NORMAL)
  paymentMethodType     PaymentMethodType       @default(COD)
  paymentMethodName     String                  @default("Cash on delivery")
  paymentReference      String?
  paymentNote           String?
  fulfillmentStatus     FulfillmentStatus       @default(UNFULFILLED)
  currency              String
  subtotalAmount        Decimal                 @db.Decimal(12, 2)
  shippingAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  shippingRateId        String?
  shippingRateName      String?
  shippingDistrict      String?
  shippingCity          String?
  shippingArea          String?
  discountAmount        Decimal                 @default(0) @db.Decimal(12, 2)
  /// Kept apart from `discountAmount` on purpose. One is a code the shopper
  /// entered, the other is what the shelf arrangement was worth, and an invoice
  /// that added them together could not tell the customer which was which.
  bundleDiscountAmount  Decimal                 @default(0) @db.Decimal(12, 2)
  /// The coupon this order's `discountAmount` came from, if any. Deliberately
  /// not a relation: the code is copied alongside it so an order still explains
  /// its own discount after the coupon row is gone.
  couponId              String?
  couponCode            String?
  taxAmount             Decimal                 @default(0) @db.Decimal(12, 2)
  totalAmount           Decimal                 @db.Decimal(12, 2)
  customerName          String
  customerEmail         String?
  customerPhone         String
  shippingAddressId     String?
  billingAddressId      String?
  notes                 String?
  /// The checkout submission that produced this order.
  ///
  /// Generated once per checkout page load and posted back with the form, so a
  /// double tap, a request retried after its response was lost, or the back
  /// button returns the order that was already placed instead of placing a
  /// second one. Null for orders the seller typed in by hand and for every
  /// order placed before this column existed.
  ///
  /// The uniqueness this relies on is a real unique index, but it is created by
  /// `ensureCheckoutSubmissionSchema` rather than declared here as `@@unique`.
  /// That file explains why: `db push` will not add a unique constraint
  /// unattended, and it drops a plain index it does not know about — so the
  /// index is partial (`WHERE ... IS NOT NULL`), which Prisma cannot express
  /// and therefore leaves alone. Keep the two in sync.
  checkoutSubmissionId  String?
  /// The address the checkout was posted from, as reported by the reverse
  /// proxy. Null for orders the seller typed in by hand and for every order
  /// placed before this column existed. Read only by the fraud tooling: it is
  /// client-controllable, so it is a signal, never an identity.
  ipAddress             String?
  verifiedAt            DateTime?
  markedFakeAt          DateTime?
  /// Stored output of the rule-based risk engine (modules/fake-orders).
  /// Written whenever the order or its customer history changes, never on read.
  riskScore             Int                     @default(0)
  riskLevel             OrderRiskLevel          @default(LOW)
  /// The `RiskFactor[]` that produced `riskScore`, so the review page can show
  /// the breakdown without re-running the engine.
  riskFactors           Json?
  riskAssessedAt        DateTime?
  /// Set by every manual verification action. While it is null the engine owns
  /// `verificationStatus`; once set, a seller decision is final and re-assessment
  /// will never move the order back into the queue on the same signals.
  verificationDecidedAt DateTime?
  store                 Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer              Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress       Address?                @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress        Address?                @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items                 OrderItem[]
  bundles               OrderBundle[]
  shipments             Shipment[]
  returns               OrderReturn[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([verificationStatus])
  @@index([storeId, verificationStatus])
  @@index([storeId, riskLevel])
  @@index([storeId, riskAssessedAt])
  @@index([storeId, ipAddress])
  @@index([shippingAddressId])
  @@index([billingAddressId])
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  productId   String?
  /// Which option of the product was sold, when the product has options.
  ///
  /// Stock lives on the variant for these lines and on the product for the
  /// rest, so editing an order cannot put a unit back without knowing which.
  /// Null on lines written before this column existed, and on every line for a
  /// product that has no options at all — order editing tells the two apart by
  /// looking the SKU up rather than guessing.
  variantId   String?
  /// Set when this line was sold past the stock on hand, so the order can say
  /// which of its products the customer is still waiting for.
  isPreorder  Boolean           @default(false)
  /// Where this line came from, for the merchandising report.
  source      OrderItemSource   @default(CART)
  title       String
  sku         String?
  price       Decimal           @db.Decimal(12, 2)
  quantity    Int
  total       Decimal           @db.Decimal(12, 2)
  imageUrl    String?
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  returnItems OrderReturnItem[]
  createdAt   DateTime          @default(now())

  @@index([orderId])
  @@index([productId])
}

// The two models below back tables that are also created at runtime by
// ensureOrderReturnSchema() (modules/returns/return-schema.ts). They mirror that
// DDL exactly — including `onUpdate: NoAction` (the raw DDL omits an ON UPDATE
// clause) and the custom index names — so `db push` stays a no-op.
//
// `type`, `status`, `reason` and `refundMethod` are TEXT rather than Postgres
// enums for the same reason ProductTaxonomy."type" is: the runtime DDL has to be
// idempotent and `CREATE TYPE` is not. The allowed values are the single source
// of truth in modules/returns/return.schema.ts.

/// One after-sale settlement against a delivered order: goods coming back,
/// goods going back out, money going back, or some combination.
///
/// All three of Return, Exchange and Refund are the same row with a different
/// `type`, because they share every field that matters — which lines, why, what
/// it is worth, and where it is in the approve/receive/settle workflow. Splitting
/// them into three tables would have triplicated that and still left an exchange
/// unable to say what it refunds.
model OrderReturn {
  id                   String            @id @default(cuid())
  storeId              String
  orderId              String
  customerId           String?
  returnNumber         String
  /// RETURN | EXCHANGE | REFUND
  type                 String
  status               String            @default("REQUESTED")
  reason               String            @default("OTHER")
  reasonNote           String?
  /// Snapshot of who asked, so a request still reads correctly after the
  /// customer record is edited or detached.
  customerName         String
  customerPhone        String
  currency             String
  /// What the returned lines were sold for, before fees.
  itemsAmount          Decimal           @default(0) @db.Decimal(12, 2)
  /// What the replacement lines are worth. EXCHANGE only; zero elsewhere.
  replacementAmount    Decimal           @default(0) @db.Decimal(12, 2)
  shippingRefundAmount Decimal           @default(0) @db.Decimal(12, 2)
  restockingFee        Decimal           @default(0) @db.Decimal(12, 2)
  /// Money owed back to the customer once the settlement is priced. On an
  /// exchange this is what is left after the replacement is charged against the
  /// return, so a like-for-like swap settles at zero.
  refundAmount         Decimal           @default(0) @db.Decimal(12, 2)
  /// The other side of that subtraction: what the customer still owes when the
  /// replacement costs more than what came back.
  dueAmount            Decimal           @default(0) @db.Decimal(12, 2)
  refundMethod         String            @default("ORIGINAL_PAYMENT")
  refundReference      String?
  /// Whether receiving the goods puts them back on the shelf. Off for anything
  /// damaged or defective, which is why it is a per-request decision.
  restockItems         Boolean           @default(true)
  resolutionNote       String?
  approvedAt           DateTime?
  rejectedAt           DateTime?
  receivedAt           DateTime?
  /// Set the first time stock is moved back. Its only job is to keep a second
  /// receive from double-counting the shelf.
  restockedAt          DateTime?
  refundedAt           DateTime?
  completedAt          DateTime?
  cancelledAt          DateTime?
  store                Store             @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  order                Order             @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  customer             Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  items                OrderReturnItem[]
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @default(now()) @updatedAt

  @@unique([storeId, returnNumber], map: "OrderReturn_store_number_key")
  @@index([storeId, type], map: "OrderReturn_store_type_idx")
  @@index([storeId, status], map: "OrderReturn_store_status_idx")
  @@index([orderId], map: "OrderReturn_order_idx")
  @@index([customerId], map: "OrderReturn_customer_idx")
}

/// One order line coming back, and — on an exchange — the line going out for it.
///
/// The replacement rides on the same row rather than in a second table because
/// an exchange is always a swap of one line for another: keeping them together
/// is what lets the pricing and the two stock movements be read off a single
/// record.
model OrderReturnItem {
  id                   String      @id @default(cuid())
  returnId             String
  orderItemId          String?
  productId            String?
  title                String
  sku                  String?
  imageUrl             String?
  unitPrice            Decimal     @db.Decimal(12, 2)
  quantity             Int
  total                Decimal     @db.Decimal(12, 2)
  replacementProductId String?
  replacementTitle     String?
  replacementSku       String?
  replacementUnitPrice Decimal?    @db.Decimal(12, 2)
  replacementQuantity  Int         @default(0)
  orderReturn          OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  orderItem            OrderItem?  @relation(fields: [orderItemId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  product              Product?    @relation(fields: [productId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  replacementProduct   Product?    @relation("OrderReturnReplacementProduct", fields: [replacementProductId], references: [id], onDelete: SetNull, onUpdate: NoAction)
  createdAt            DateTime    @default(now())

  @@index([returnId], map: "OrderReturnItem_return_idx")
  @@index([productId], map: "OrderReturnItem_product_idx")
}

/// Server-side mirror of one storefront cart.
///
/// The live cart is a signed httpOnly cookie (modules/cart/cart.service.ts), so
/// nothing about it is queryable and a seller could never see a cart that was
/// left behind. Every cart write mirrors the cart here, keyed by a random
/// `token` that is carried in the same cookie. A row counts as abandoned once
/// `lastActivityAt` is older than the inactivity window; it is deleted when the
/// shopper empties the cart or checks out inside that window, and marked
/// RECOVERED when a checkout completes after it.
model AbandonedCart {
  id                   String              @id @default(cuid())
  storeId              String
  token                String
  customerId           String?
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  status               AbandonedCartStatus @default(NOT_CONTACTED)
  stage                AbandonedCartStage  @default(CART)
  itemCount            Int                 @default(0)
  subtotalAmount       Decimal             @default(0) @db.Decimal(12, 2)
  items                Json
  note                 String?
  // Everything the shopper had typed into checkout when they stopped. Nullable
  // and unvalidated on purpose: a half-filled form is exactly what this is for,
  // and none of it has been through checkoutSchema the way an order's has.
  country              String?
  district             String?
  city                 String?
  area                 String?
  addressLine1         String?
  addressLine2         String?
  postalCode           String?
  shippingRateId       String?
  paymentMethod        String?
  couponCode           String?
  ipAddress            String?
  // How many times Place Order was pressed, and why the last press did not
  // become an order. `failureCode` holds an IncompleteOrderFailureCode value.
  attemptCount         Int                 @default(0)
  failureCode          String?
  failureReason        String?
  failedAt             DateTime?
  contactChannel       String?
  contactedAt          DateTime?
  recoveredAt          DateTime?
  recoveredOrderId     String?
  recoveredOrderNumber String?
  lastActivityAt       DateTime            @default(now())
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt

  @@unique([storeId, token])
  @@index([storeId, lastActivityAt])
  @@index([storeId, status])
  @@index([storeId, stage, lastActivityAt])
  @@index([customerId])
}

model CourierAccount {
  id                String     @id @default(cuid())
  storeId           String
  provider          String
  label             String?
  isEnabled         Boolean    @default(true)
  isDefault         Boolean    @default(false)
  credentialsCipher String?
  credentialsPublic Json?
  secretHint        String?
  metadata          Json?
  lastTestedAt      DateTime?
  lastTestStatus    String?
  lastTestMessage   String?
  balanceAmount     Decimal?   @db.Decimal(12, 2)
  balanceCheckedAt  DateTime?
  // Opaque per-account routing token that sits in the webhook URL path. The
  // carrier's payload carries no store identity, so this is what tells us which
  // tenant an inbound delivery update belongs to.
  webhookToken      String?    @unique
  // The Bearer/signature secret the seller pastes into the carrier's panel,
  // encrypted with the same key as the credentials.
  webhookSecret     String?
  webhookLastSeenAt DateTime?
  store             Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipments         Shipment[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

model Shipment {
  id                 String          @id @default(cuid())
  storeId            String
  orderId            String
  provider           String
  courierAccountId   String?
  status             ShipmentStatus  @default(PENDING)
  providerStatus     String?
  providerShipmentId String?
  trackingCode       String?
  invoiceReference   String
  codAmount          Decimal         @default(0) @db.Decimal(12, 2)
  labelUrl           String?
  requestHash        String?
  attemptCount       Int             @default(0)
  lastError          String?
  lastSyncedAt       DateTime?
  bookedAt           DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  rawResponse        Json?
  createdByUserId    String?
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierAccount     CourierAccount? @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  events             DeliveryEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@unique([storeId, orderId, provider])
  @@unique([storeId, provider, invoiceReference])
  @@index([storeId, status])
  @@index([orderId])
  @@index([trackingCode])
  @@index([courierAccountId])
  @@index([storeId, invoiceReference])
  @@index([provider, providerShipmentId])
}

model DeliveryEvent {
  id             String         @id @default(cuid())
  storeId        String
  shipmentId     String
  status         ShipmentStatus
  providerStatus String?
  message        String?
  source         String         @default("SYSTEM")
  occurredAt     DateTime       @default(now())
  payload        Json?
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([shipmentId, occurredAt])
  @@index([storeId])
}

model CourierCustomerScore {
  id             String   @id @default(cuid())
  storeId        String
  provider       String
  phone          String
  totalParcels   Int      @default(0)
  totalDelivered Int      @default(0)
  totalCancelled Int      @default(0)
  successRatio   Decimal? @db.Decimal(5, 2)
  raw            Json?
  checkedAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([storeId, provider, phone])
  @@index([storeId])
}

/// A group of terms the storefront treats as interchangeable, in every
/// direction: a shopper typing any one of them matches products written with
/// any other. Built for Banglish/Bangla pairs ("jama"/"জামা"/"dress") as much
/// as for English ones, since the catalogue and the shopper rarely agree on
/// which script or spelling to use.
model SearchSynonym {
  id        String   @id @default(cuid())
  storeId   String
  terms     String[]
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([storeId])
}

/// Pins a product above the ranked results for one exact query, so a seller can
/// override relevance where they know better than the score does.
model SearchBoost {
  id        String   @id @default(cuid())
  storeId   String
  /// Normalised (trimmed, lowercased) so lookups match what the shopper typed.
  query     String
  productId String
  position  Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, query, productId])
  @@index([storeId, query])
}

/// Sends a query straight to a URL instead of rendering results — the usual use
/// is routing "delivery" or "return policy" at a real page rather than at an
/// empty product grid.
model SearchRedirect {
  id        String   @id @default(cuid())
  storeId   String
  /// Normalised the same way as SearchBoost.query.
  query     String
  targetUrl String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, query])
  @@index([storeId])
}

/// One row per distinct query, rolled up rather than appended.
///
/// A row per search would grow without bound and answer no question this
/// feature asks; what a seller needs is which searches are common and which
/// return nothing, both of which this shape gives in a single scan.
model SearchQueryStat {
  id              String   @id @default(cuid())
  storeId         String
  query           String
  searchCount     Int      @default(0)
  lastResultCount Int      @default(0)
  lastSearchedAt  DateTime @default(now())
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([storeId, query])
  @@index([storeId])
}

enum CouponDiscountType {
  /// Percent off the cart subtotal, optionally capped by `maxDiscountAmount`.
  PERCENTAGE
  /// Flat amount off the cart subtotal.
  FIXED_CART
  /// The shipping charge is waived. `discountValue` is unused.
  FREE_SHIPPING
}

enum CouponStatus {
  ACTIVE
  INACTIVE
}

/// A discount code a shopper can enter at checkout.
///
/// `usedCount` is denormalised from `redemptions` on purpose: the total-usage
/// cap has to be enforced with a single atomic increment inside the order
/// transaction, and counting rows first would be a check-then-write race that
/// lets a "100 uses" coupon go to 105 under load.
///
/// Whether a coupon is *usable* is never just `status` — the window, the caps
/// and the subtotal bounds all participate. `modules/coupons` derives that in
/// one place so the dashboard and checkout cannot answer it differently.
model Coupon {
  id                    String             @id @default(cuid())
  storeId               String
  /// Always stored upper-cased, so `@@unique([storeId, code])` is effectively
  /// case-insensitive: every write goes through `normaliseCouponCode` first.
  code                  String
  name                  String
  description           String?
  discountType          CouponDiscountType
  /// Percent (0-100) for PERCENTAGE, money for FIXED_CART, unused for FREE_SHIPPING.
  discountValue         Decimal            @default(0) @db.Decimal(12, 2)
  /// Ceiling on what a PERCENTAGE coupon may take off — "20% off, up to 500".
  maxDiscountAmount     Decimal?           @db.Decimal(12, 2)
  /// Cart subtotal bounds the code is accepted between. Null means unbounded.
  minSubtotal           Decimal?           @db.Decimal(12, 2)
  maxSubtotal           Decimal?           @db.Decimal(12, 2)
  /// Null means unlimited.
  usageLimitTotal       Int?
  usageLimitPerCustomer Int?
  usedCount             Int                @default(0)
  startsAt              DateTime?
  expiresAt             DateTime?
  status                CouponStatus       @default(ACTIVE)
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  redemptions           CouponRedemption[]
  campaigns             Campaign[]
  createdAt             DateTime           @default(now())
  updatedAt             DateTime           @default(now()) @updatedAt

  @@unique([storeId, code])
  @@index([storeId, status])
  @@index([storeId, createdAt])
}

/// One successful use of a coupon, written in the same transaction as the order.
///
/// The per-customer cap is keyed on `customerPhone` rather than `customerId`
/// because a COD checkout can produce an order without ever resolving a
/// `Customer` row, and phone is what `Customer` is already unique on within a
/// store. `customerId` is kept when there is one, for reporting.
model CouponRedemption {
  id             String   @id @default(cuid())
  couponId       String
  storeId        String
  orderId        String
  customerId     String?
  customerPhone  String
  discountAmount Decimal  @db.Decimal(12, 2)
  coupon         Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())

  /// Replaying an order write must not double-count a redemption.
  @@unique([couponId, orderId])
  @@index([couponId, customerPhone])
  @@index([storeId, createdAt])
}

enum CampaignChannel {
  EMAIL
  SMS
}

enum CampaignStatus {
  CANCELLED
  /// Every recipient has been attempted and at least one campaign-level step failed.
  FAILED
  DRAFT
  PAUSED
  SCHEDULED
  /// Recipients have been materialised and the runner is working through them.
  SENDING
  SENT
}

enum CampaignRecipientStatus {
  /// The store's plan allowance was used up before this one was reached.
  BLOCKED
  FAILED
  PENDING
  /// Claimed by a runner batch. A row stuck here is a crashed batch, not a lost message.
  SENDING
  SENT
  /// Deliberately not attempted — no usable address, or opted out after the send began.
  SKIPPED
}

/// A saved segment of a store's customers.
///
/// `rules` is the segment as the seller described it, not the customers it
/// matched — the same audience run a week later should reach the people who
/// qualify then. `cachedCount` is only ever a display figure; nothing decides
/// anything from it.
model CampaignAudience {
  id          String     @id @default(cuid())
  storeId     String
  name        String
  description String?
  rules       Json
  /// Last computed size, for the list screen. Recomputed on demand, never trusted.
  cachedCount Int?
  countedAt   DateTime?
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaigns   Campaign[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([storeId, createdAt])
}

/// A reusable message body, with `{{name}}`-style placeholders left in.
model CampaignTemplate {
  id        String          @id @default(cuid())
  storeId   String
  channel   CampaignChannel @default(SMS)
  name      String
  subject   String?
  body      String
  store     Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @default(now()) @updatedAt

  @@unique([storeId, name])
  @@index([storeId, channel])
}

/// One marketing send: a message, an audience, and the state of getting it out.
///
/// `audienceSnapshot` freezes the rules at the moment the send started. Editing
/// an audience mid-send must not change who a running campaign is reaching, and
/// a campaign finished months ago has to still be able to say who it went to.
///
/// The three counters are denormalised from `recipients`. They are what the
/// progress bar reads, and counting several thousand rows on every dashboard
/// poll to render one percentage is not worth it.
model Campaign {
  id               String              @id @default(cuid())
  storeId          String
  name             String
  channel          CampaignChannel     @default(SMS)
  status           CampaignStatus      @default(DRAFT)
  /// Rendered per recipient at send time; placeholders are stored as written.
  body             String
  /// EMAIL only.
  subject          String?
  /// Offer attached to this send, surfaced to the body as `{{coupon_code}}`.
  couponId         String?
  audienceId       String?
  audienceSnapshot Json?
  scheduledAt      DateTime?
  startedAt        DateTime?
  completedAt      DateTime?
  /// Set when the campaign itself failed, as opposed to individual recipients.
  errorMessage     String?
  totalCount       Int                 @default(0)
  sentCount        Int                 @default(0)
  failedCount      Int                 @default(0)
  store            Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  audience         CampaignAudience?   @relation(fields: [audienceId], references: [id], onDelete: SetNull)
  coupon           Coupon?             @relation(fields: [couponId], references: [id], onDelete: SetNull)
  recipients       CampaignRecipient[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @default(now()) @updatedAt

  @@index([storeId, status])
  @@index([storeId, createdAt])
  /// The runner's sweep: campaigns due to start, oldest first.
  @@index([status, scheduledAt])
}

/// One intended message, and what became of it.
///
/// This table *is* the queue. A runner claims a batch of `PENDING` rows, sends
/// them, and writes back — which buys idempotency, resumability after a crash,
/// a per-recipient audit trail and honest progress, all without a queue server
/// this project would otherwise have to run and operate.
///
/// `recipient` is denormalised from the customer rather than joined at send
/// time: a campaign must go to the number it was addressed to, even if the
/// customer edits their phone while it is running.
model CampaignRecipient {
  id                String                  @id @default(cuid())
  campaignId        String
  customerId        String?
  /// Phone or email, depending on the campaign's channel.
  recipient         String
  /// Copied for `{{name}}`, so rendering needs no join.
  name              String?
  status            CampaignRecipientStatus @default(PENDING)
  /// What the gateway called this message, when it gave it a name. The matching
  /// `MessageDelivery` row is the fuller record; this is what a provider's own
  /// dashboard can be searched by.
  providerMessageId String?
  /// Set by the runner when it takes a batch, so it can read back exactly the
  /// rows it won rather than the rows another runner claimed a moment earlier.
  /// Cleared once the row reaches a terminal status.
  claimToken        String?
  errorMessage      String?
  sentAt            DateTime?
  attempts          Int                     @default(0)
  campaign          Campaign                @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer          Customer?               @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @default(now()) @updatedAt

  /// One message per address per campaign, however many times enqueue is run.
  @@unique([campaignId, recipient])
  /// The claim query: pending rows for one campaign.
  @@index([campaignId, status])
  @@index([claimToken])
  @@index([customerId])
}

/// One product a shopper saved, on one store.
///
/// Keyed by `token` rather than by a customer because a storefront has no
/// shopper login to key it by: the only identity available is the signed cookie
/// `wishlist-token.ts` mints, which is the same shape the cart's snapshot token
/// already uses. The token is per store, so one shopper's list on two shops on
/// this platform are two unrelated lists and neither is reachable from the
/// other's cookie.
///
/// The row stores an id and nothing else — no title, no price, no image. A
/// wishlist is looked at weeks after it is filled, which is exactly long enough
/// for a copied price to be wrong, so the products are re-read through
/// `publicProductWhere` on every render: a product that went DRAFT, HIDDEN or
/// away simply stops appearing, the same way it stops being linkable.
model WishlistItem {
  id        String   @id @default(cuid())
  storeId   String
  token     String
  productId String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  /// Saving twice is saving once. The toggle relies on this.
  @@unique([storeId, token, productId])
  /// One shopper's list, newest first.
  @@index([storeId, token])
  /// The seller's demand report: how many shoppers saved each product.
  @@index([storeId, productId])
  @@index([productId])
}
