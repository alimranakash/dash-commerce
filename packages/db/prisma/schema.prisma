/// Server-side mirror of one storefront cart.
///
/// The live cart is a signed httpOnly cookie (modules/cart/cart.service.ts), so
/// nothing about it is queryable and a seller could never see a cart that was
/// left behind. Every cart write mirrors the cart here, keyed by a random
/// `token` that is carried in the same cookie. A row counts as abandoned once
/// `lastActivityAt` is older than the inactivity window; it is deleted when the
/// shopper empties the cart or checks out inside that window, and marked
/// RECOVERED when a checkout completes after it.
model AbandonedCart {
  id                   String              @id @default(cuid())
  storeId              String
  token                String
  customerId           String?
  customerName         String?
  customerEmail        String?
  customerPhone        String?
  status               AbandonedCartStatus @default(NOT_CONTACTED)
  itemCount            Int                 @default(0)
  subtotalAmount       Decimal             @default(0) @db.Decimal(12, 2)
  items                Json
  note                 String?
  contactChannel       String?
  contactedAt          DateTime?
  recoveredAt          DateTime?
  recoveredOrderId     String?
  recoveredOrderNumber String?
  lastActivityAt       DateTime            @default(now())
  store                Store               @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer             Customer?           @relation(fields: [customerId], references: [id], onDelete: SetNull)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @default(now()) @updatedAt

  @@unique([storeId, token])
  @@index([storeId, lastActivityAt])
  @@index([storeId, status])
  @@index([customerId])
}

model CourierAccount {
  id                String     @id @default(cuid())
  storeId           String
  provider          String
  label             String?
  isEnabled         Boolean    @default(true)
  isDefault         Boolean    @default(false)
  credentialsCipher String?
  credentialsPublic Json?
  secretHint        String?
  metadata          Json?
  lastTestedAt      DateTime?
  lastTestStatus    String?
  lastTestMessage   String?
  balanceAmount     Decimal?   @db.Decimal(12, 2)
  balanceCheckedAt  DateTime?
  // Opaque per-account routing token that sits in the webhook URL path. The
  // carrier's payload carries no store identity, so this is what tells us which
  // tenant an inbound delivery update belongs to.
  webhookToken      String?    @unique
  // The Bearer/signature secret the seller pastes into the carrier's panel,
  // encrypted with the same key as the credentials.
  webhookSecret     String?
  webhookLastSeenAt DateTime?
  store             Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipments         Shipment[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

model Shipment {
  id                 String          @id @default(cuid())
  storeId            String
  orderId            String
  provider           String
  courierAccountId   String?
  status             ShipmentStatus  @default(PENDING)
  providerStatus     String?
  providerShipmentId String?
  trackingCode       String?
  invoiceReference   String
  codAmount          Decimal         @default(0) @db.Decimal(12, 2)
  labelUrl           String?
  requestHash        String?
  attemptCount       Int             @default(0)
  lastError          String?
  lastSyncedAt       DateTime?
  bookedAt           DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  rawResponse        Json?
  createdByUserId    String?
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierAccount     CourierAccount? @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  events             DeliveryEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@unique([storeId, orderId, provider])
  @@unique([storeId, provider, invoiceReference])
  @@index([storeId, status])
  @@index([orderId])
  @@index([trackingCode])
  @@index([courierAccountId])
  @@index([storeId, invoiceReference])
  @@index([provider, providerShipmentId])
}

model DeliveryEvent {
  id             String         @id @default(cuid())
  storeId        String
  shipmentId     String
  status         ShipmentStatus
  providerStatus String?
  message        String?
  source         String         @default("SYSTEM")
  occurredAt     DateTime       @default(now())
  payload        Json?
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([shipmentId, occurredAt])
  @@index([storeId])
}

model CourierCustomerScore {
  id             String   @id @default(cuid())
  storeId        String
  provider       String
  phone          String
  totalParcels   Int      @default(0)
  totalDelivered Int      @default(0)
  totalCancelled Int      @default(0)
  successRatio   Decimal? @db.Decimal(5, 2)
  raw            Json?
  checkedAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([storeId, provider, phone])
  @@index([storeId])
}

/// A group of terms the storefront treats as interchangeable, in every
/// direction: a shopper typing any one of them matches products written with
/// any other. Built for Banglish/Bangla pairs ("jama"/"জামা"/"dress") as much
/// as for English ones, since the catalogue and the shopper rarely agree on
/// which script or spelling to use.
model SearchSynonym {
  id        String   @id @default(cuid())
  storeId   String
  terms     String[]
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@index([storeId])
}

/// Pins a product above the ranked results for one exact query, so a seller can
/// override relevance where they know better than the score does.
model SearchBoost {
  id        String   @id @default(cuid())
  storeId   String
  /// Normalised (trimmed, lowercased) so lookups match what the shopper typed.
  query     String
  productId String
  position  Int      @default(0)
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([storeId, query, productId])
  @@index([storeId, query])
}

/// Sends a query straight to a URL instead of rendering results — the usual use
/// is routing "delivery" or "return policy" at a real page rather than at an
/// empty product grid.
model SearchRedirect {
  id        String   @id @default(cuid())
  storeId   String
  /// Normalised the same way as SearchBoost.query.
  query     String
  targetUrl String
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, query])
  @@index([storeId])
}

/// One row per distinct query, rolled up rather than appended.
///
/// A row per search would grow without bound and answer no question this
/// feature asks; what a seller needs is which searches are common and which
/// return nothing, both of which this shape gives in a single scan.
model SearchQueryStat {
  id              String   @id @default(cuid())
  storeId         String
  query           String
  searchCount     Int      @default(0)
  lastResultCount Int      @default(0)
  lastSearchedAt  DateTime @default(now())
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@unique([storeId, query])
  @@index([storeId])
}
