model StoreDomain {
  id              String          @id @default(cuid())
  storeId         String
  domain          String          @unique
  type            StoreDomainType
  isPrimary       Boolean         @default(false)
  verifiedAt      DateTime?
  // Result of the last DNS check, so a seller still sees why a domain failed
  // after reloading the page. `lastCheckStatus` holds a DomainCheckStatus value.
  lastCheckedAt   DateTime?
  lastCheckStatus String?
  lastCheckDetail String?
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([storeId])
}

model StoreSetting {
  id              String   @id @default(cuid())
  storeId         String   @unique
  logoUrl         String?
  faviconUrl      String?
  tagline         String?
  contactEmail    String?
  contactPhone    String?
  supportPhone    String?
  businessAddress String?
  facebookUrl     String?
  instagramUrl    String?
  whatsappNumber  String?
  moduleSettings  Json?
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

/// When a store is allowed to text its customers.
///
/// Deliberately holds no credentials. Every message goes through the platform's
/// one gateway (`MessagingSetting`), and what a store may spend is set by its
/// plan's `smsLimit` — so a seller chooses *when* messages are sent, never *how
/// many* or *through what*.
model StoreMessagingSetting {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  /// The master switch. Off means nothing is sent for this store at all.
  smsEnabled          Boolean  @default(false)
  /// Confirm a cash-on-delivery number with a code before the order is placed.
  checkoutOtpEnabled  Boolean  @default(false)
  /// Text the customer their order details the moment the order goes through.
  orderConfirmEnabled Boolean  @default(false)
  /// A second text on the same order, written by the seller. Kept apart from the
  /// switch above because turning it on doubles what confirming an order costs.
  orderCustomEnabled  Boolean  @default(false)
  /// The seller's own copy, with its placeholders filled in at send time. Null
  /// until they write something, and a blank one sends nothing however the
  /// switch is set — an empty message must never leave as a bare template.
  orderCustomMessage  String?
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model ThemeSetting {
  id                   String   @id @default(cuid())
  storeId              String   @unique
  themeName            String   @default("Theme v1")
  primaryColor         String   @default("#135d66")
  secondaryColor       String?
  heroTitle            String   @default("Discover what is new")
  heroSubtitle         String?
  heroImageUrl         String?
  announcementText     String?
  featuredSectionTitle String   @default("Products worth a closer look")
  advancedSettings     Json?
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
}

/// Marketing / analytics configuration for one store.
///
/// Deliberately a table rather than a slice of `StoreSetting.moduleSettings`:
/// the Conversions API token is a secret (secrets never live in that JSON — see
/// CourierAccount), these columns are read on every storefront render, and
/// change logging wants a per-field before/after diff.
/// The one-tick offer on the checkout page.
///
/// One row per store: a checkout with two bumps on it is a checkout nobody
/// reads, so the model refuses to hold a second rather than leaving the choice
/// of which to show to whatever the query happened to sort first.
///
/// `productId` is optional, and that is the interesting half. Pinned, the
/// same product is offered to everyone. Left empty, the offer is whatever the
/// cart's own pairings and this store's co-purchase history put at the top —
/// which is why the pairing work had to come first.
///
/// The discount is stored, never the price. What the shopper is charged is
/// worked out from the product's live price on both the render and the submit,
/// so a price change cannot leave a stale offer standing.
/// A deal priced off what is in the cart together, rather than off the cart
/// total.
///
/// This is what a coupon cannot express. A coupon is one number against the
/// subtotal; a bundle has to find the qualifying units, price only those, and
/// do it again for every further set the cart can pay for.
///
/// Deliberately no code to type: a bundle is a shelf arrangement, not a reward
/// for knowing a password, so it applies the moment the cart qualifies.
model Bundle {
  id            String             @id @default(cuid())
  storeId       String
  name          String
  /// Shown on the cart and checkout beside the saving, so it has to read as a
  /// sentence to a shopper: "Buy 2, get 1 free".
  description   String             @default("")
  type          BundleType         @default(SET)
  discountType  BundleDiscountType @default(PERCENTAGE)
  discountValue Decimal            @default(0) @db.Decimal(12, 2)
  /// QUANTITY only: how many units qualify, and how many of them are cut.
  buyQuantity   Int                @default(0)
  getQuantity   Int                @default(0)
  status        BundleStatus       @default(ACTIVE)
  startsAt      DateTime?
  expiresAt     DateTime?
  store         Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  items         BundleItem[]
  orderBundles  OrderBundle[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @default(now()) @updatedAt

  @@index([storeId, status])
}

/// One product a bundle is built from.
///
/// `quantity` is what SET requires of this product. QUANTITY bundles ignore it
/// and count units across every listed product instead.
model BundleItem {
  id        String  @id @default(cuid())
  bundleId  String
  productId String
  quantity  Int     @default(1)
  bundle    Bundle  @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([bundleId, productId])
  @@index([productId])
}

/// One bundle, as it applied to one order.
///
/// Written in the order's own transaction and carrying its own name and amount,
/// for the same reason `Order.couponCode` is copied rather than joined: the
/// order has to keep explaining itself after the bundle is renamed or deleted.
model OrderBundle {
  id             String   @id @default(cuid())
  orderId        String
  storeId        String
  /// Null once the bundle itself is gone; the name and amount stay.
  bundleId       String?
  name           String
  discountAmount Decimal  @db.Decimal(12, 2)
  /// How many times the cart paid for it.
  timesApplied   Int      @default(1)
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bundle         Bundle?  @relation(fields: [bundleId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())

  @@index([orderId])
  @@index([storeId, createdAt])
}

model OrderBump {
  id            String                @id @default(cuid())
  storeId       String                @unique
  enabled       Boolean               @default(false)
  /// The pinned product, or null to let the cart decide.
  productId     String?
  headline      String                @default("Add this to your order")
  description   String                @default("")
  discountType  OrderBumpDiscountType @default(PERCENTAGE)
  /// Percent (0-100) for PERCENTAGE, money for FIXED.
  discountValue Decimal               @default(0) @db.Decimal(12, 2)
  store         Store                 @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product       Product?              @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @default(now()) @updatedAt

  @@index([productId])
}

model MarketingSetting {
  id                     String   @id @default(cuid())
  storeId                String   @unique
  ga4MeasurementId       String?
  ga4MpEnabled           Boolean  @default(false)
  /// AES-256-GCM. Measurement Protocol API secret — server-side only, never rendered into storefront HTML.
  ga4ApiSecretCipher     String?
  /// Last four characters, so settings can prove which secret is stored.
  ga4ApiSecretHint       String?
  gtmContainerId         String?
  googleSiteVerification String?
  googleAdsConversionId  String?
  metaPixelId            String?
  metaDomainVerification String?
  metaCapiEnabled        Boolean  @default(false)
  /// AES-256-GCM. Server-side only — never rendered into storefront HTML.
  metaCapiTokenCipher    String?
  /// Last four characters, so settings can prove which token is stored.
  metaCapiTokenHint      String?
  tiktokPixelId          String?
  customEnabled          Boolean  @default(false)
  customHeaderCode       String?
  customBodyCode         String?
  customFooterCode       String?
  updatedById            String?
  store                  Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy              User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([storeId])
}

model PaymentMethod {
  id            String            @id @default(cuid())
