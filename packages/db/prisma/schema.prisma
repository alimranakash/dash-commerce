/// Plan entitlements, one row per granted capability. A join table rather than a
/// boolean column per feature, so adding a feature is data, not a migration.
/// `featureKey` is validated in application code against `PLAN_FEATURE_KEYS`.
model PlanFeature {
  id         String   @id @default(cuid())
  planId     String   @map("plan_id")
  featureKey String   @map("feature_key")
  plan       Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([planId, featureKey])
  @@index([featureKey])
  @@map("plan_features")
}

model Subscription {
  id                    String             @id @default(cuid())
  organizationId        String             @map("organization_id")
  storeId               String             @unique @map("store_id")
  planId                String             @map("plan_id")
  status                SubscriptionStatus @default(TRIALING)
  billingCycle          BillingCycle       @default(MONTHLY) @map("billing_cycle")
  trialStartsAt         DateTime?          @map("trial_starts_at")
  trialEndsAt           DateTime?          @map("trial_ends_at")
  currentPeriodStartsAt DateTime?          @map("current_period_starts_at")
  currentPeriodEndsAt   DateTime?          @map("current_period_ends_at")
  cancelAtPeriodEnd     Boolean            @default(false) @map("cancel_at_period_end")
  /// Replaces the plan's monthly SMS allowance for this one store. `null` means
  /// follow the plan; `0` means unlimited, the same convention the plan uses.
  smsLimitOverride      Int?               @map("sms_limit_override")
  cancelledAt           DateTime?          @map("cancelled_at")
  organization          Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store                 Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan                  Plan               @relation(fields: [planId], references: [id])
  payments              Payment[]
  createdAt             DateTime           @default(now()) @map("created_at")
  updatedAt             DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@index([billingCycle])
  @@map("subscriptions")
}

