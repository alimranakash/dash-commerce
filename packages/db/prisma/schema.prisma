model User {
  id                      String               @id @default(cuid())
  name                    String?
  email                   String?              @unique
  emailVerified           DateTime?
  image                   String?
  phone                   String?              @unique
  phoneVerified           DateTime?
  language                String               @default("en")
  timezone                String               @default("Asia/Dhaka")
  dateFormat              String               @default("DD/MM/YYYY")
  isSuspended             Boolean              @default(false)
  passwordHash            String?
  role                    UserRole             @default(MEMBER)
  accounts                Account[]
  sessions                Session[]
  memberships             OrganizationMember[]
  staffInvitesSent        StaffInvite[]        @relation("StaffInviteSender")
  staffInvitesAccepted    StaffInvite[]        @relation("StaffInviteRecipient")
  supportTickets          SupportTicket[]      @relation("SupportTicketUser")
  assignedSupportTickets  SupportTicket[]      @relation("SupportTicketAssignee")
  supportTicketReplies    SupportTicketReply[]
  systemLogs              SystemLog[]
  marketingSettingUpdates MarketingSetting[]
  createdAt               DateTime             @default(now())
  updatedAt               DateTime             @default(now()) @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum OtpChannel {
  EMAIL
  SMS
}

enum OtpPurpose {
  CHECKOUT
  CONTACT_CHANGE
  LOGIN
  PASSWORD_RESET
  REGISTRATION
}

/// One verification code in flight.
///
/// A row outlives the code it carries: consumed and expired challenges are what
/// the hourly rate limiter counts, so deleting them on use would hand an abuser
/// a fresh allowance every time they finished a challenge. `sweepExpiredOtpChallenges`
/// clears anything old enough to be useless to both the visitor and the limiter.
///
/// `payload` holds the half-finished signup — name and an already-bcrypt-hashed
/// password — because no User row exists until the code is verified. An
/// unverified account would otherwise sit on the unique email or phone it
/// claimed, which is exactly how someone squats a number they do not own.
model OtpChallenge {
  id          String     @id @default(cuid())
  purpose     OtpPurpose
  channel     OtpChannel
  /// Normalised email or `01XXXXXXXXX`, never as the visitor typed it.
  identifier  String
  codeHash    String
  attempts    Int        @default(0)
  resendCount Int        @default(0)
  payload     Json?
  ipAddress   String?
  lastSentAt  DateTime
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@index([identifier, purpose])
  @@index([ipAddress, createdAt])
  @@index([expiresAt])
}

enum MessageChannel {
  EMAIL
  SMS
}

enum MessageDeliveryStatus {
  /// Deliberately not sent — the store had used up its plan's allowance.
  BLOCKED
  FAILED
  SENT
  SKIPPED
}

/// One outbound message, kept for when someone says it never arrived.
///
/// The body is deliberately absent. Everything this carries today is a
/// verification code, and a code sitting in a log would undo the point of only
/// storing its hash on the challenge. Template, recipient and whatever the
/// gateway said back is enough to answer "was it sent, when, and why not".
model MessageDelivery {
  id                String                @id @default(cuid())
  channel           MessageChannel
  template          String
  recipient         String
  /// Null for messages the platform sends on nobody's behalf — a sign-up code
  /// or a password reset happens before any store is in the picture, and its
  /// cost belongs to the platform rather than to a seller's allowance.
  storeId           String?
  provider          String
  providerMessageId String?
  status            MessageDeliveryStatus
  errorCode         String?
  errorMessage      String?
  createdAt         DateTime              @default(now())

  @@index([channel, createdAt])
  @@index([recipient, createdAt])
  @@index([status, createdAt])
  @@index([storeId, channel, createdAt])
}

model Organization {
  id                String               @id @default(cuid())
  name              String
  slug              String               @unique
  members           OrganizationMember[]
  staffInvites      StaffInvite[]
  stores            Store[]
  suppliers         Supplier[]
  purchases         Purchase[]
  expenseCategories ExpenseCategory[]
  expenses          Expense[]
  sales             Sale[]
  stockMovements    StockMovement[]
  subscriptions     Subscription[]
  payments          Payment[]
  supportTickets    SupportTicket[]
  systemLogs        SystemLog[]
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @default(now()) @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

/// One staff invitation. The raw token never reaches the database — only its
/// SHA-256 hash — so neither a dump nor the admin panel can be turned back into
/// a working invite link; the link is shown once, when the invite is created.
///
/// Rows are kept after they are accepted or revoked rather than deleted, so the
/// team page can answer "who invited this person, and when". A pending invite is
/// therefore expressed as a filter (`acceptedAt`/`revokedAt` null, `expiresAt`
/// in the future), not by the row's existence — see `pendingStaffInviteFilter`.
model StaffInvite {
  id             String       @id @default(cuid())
  organizationId String
  email          String
  role           UserRole     @default(MEMBER)
  tokenHash      String       @unique
  invitedById    String
  expiresAt      DateTime
  acceptedAt     DateTime?
  acceptedById   String?
  revokedAt      DateTime?
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedBy      User         @relation("StaffInviteSender", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedBy     User?        @relation("StaffInviteRecipient", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Store {
  id                         String                      @id @default(cuid())
  organizationId             String
  name                       String
  slug                       String                      @unique
  businessType               String                      @default("General Store")
  activeTemplate             String                      @default("general-default")
  activeDemoPack             String                      @default("general-demo-v1")
  demoPackInstalledAt        DateTime?
  status                     StoreStatus                 @default(DRAFT)
  currency                   String                      @default("USD")
  country                    String                      @default("US")
  timezone                   String                      @default("UTC")
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains                    StoreDomain[]
  products                   Product[]
  categories                 Category[]
  orders                     Order[]
  customers                  Customer[]
  addresses                  Address[]
  setting                    StoreSetting?
  messagingSetting           StoreMessagingSetting?
  themeSetting               ThemeSetting?
  marketingSetting           MarketingSetting?
  paymentMethods             PaymentMethod[]
  shippingZones              ShippingZone[]
  shippingRates              ShippingRate[]
  storeosConnection          StoreOSConnection?
  mediaAssets                MediaAsset[]
  purchases                  Purchase[]
  expenses                   Expense[]
  sales                      Sale[]
  stockMovements             StockMovement[]
  subscription               Subscription?
  payments                   Payment[]
  supportTickets             SupportTicket[]
  systemLogs                 SystemLog[]
  courierAccounts            CourierAccount[]
  shipments                  Shipment[]
  deliveryEvents             DeliveryEvent[]
  courierCustomerScores      CourierCustomerScore[]
  productTaxonomies          ProductTaxonomy[]
  productTaxonomyAssignments ProductTaxonomyAssignment[]
  productCategoryAssignments ProductCategoryAssignment[]
  productAttributes          ProductAttribute[]
  productAttributeValues     ProductAttributeValue[]
  productVariants            ProductVariant[]
  abandonedCarts             AbandonedCart[]
  searchSynonyms             SearchSynonym[]
  searchBoosts               SearchBoost[]
  searchRedirects            SearchRedirect[]
  searchQueryStats           SearchQueryStat[]
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @default(now()) @updatedAt

  @@index([organizationId])
}

model StoreDomain {
  id              String          @id @default(cuid())
  storeId         String
  domain          String          @unique
  type            StoreDomainType
  isPrimary       Boolean         @default(false)
  verifiedAt      DateTime?
  // Result of the last DNS check, so a seller still sees why a domain failed
  // after reloading the page. `lastCheckStatus` holds a DomainCheckStatus value.
  lastCheckedAt   DateTime?
  lastCheckStatus String?
  lastCheckDetail String?
  store           Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @default(now()) @updatedAt

  @@index([storeId])
}

model StoreSetting {
  id              String   @id @default(cuid())
  storeId         String   @unique
  logoUrl         String?
  faviconUrl      String?
  tagline         String?
  contactEmail    String?
  contactPhone    String?
  supportPhone    String?
  businessAddress String?
  facebookUrl     String?
  instagramUrl    String?
  whatsappNumber  String?
  moduleSettings  Json?
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

/// When a store is allowed to text its customers.
///
/// Deliberately holds no credentials. Every message goes through the platform's
/// one gateway (`MessagingSetting`), and what a store may spend is set by its
/// plan's `smsLimit` — so a seller chooses *when* messages are sent, never *how
/// many* or *through what*.
model StoreMessagingSetting {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  /// The master switch. Off means nothing is sent for this store at all.
  smsEnabled          Boolean  @default(false)
  /// Confirm a cash-on-delivery number with a code before the order is placed.
  checkoutOtpEnabled  Boolean  @default(false)
  /// Text the customer their order details the moment the order goes through.
  orderConfirmEnabled Boolean  @default(false)
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt
}

model ThemeSetting {
  id                   String   @id @default(cuid())
  storeId              String   @unique
  themeName            String   @default("Theme v1")
  primaryColor         String   @default("#135d66")
  secondaryColor       String?
  heroTitle            String   @default("Discover what is new")
  heroSubtitle         String?
  heroImageUrl         String?
  announcementText     String?
  featuredSectionTitle String   @default("Products worth a closer look")
  advancedSettings     Json?
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
}

/// Marketing / analytics configuration for one store.
///
/// Deliberately a table rather than a slice of `StoreSetting.moduleSettings`:
/// the Conversions API token is a secret (secrets never live in that JSON — see
/// CourierAccount), these columns are read on every storefront render, and
/// change logging wants a per-field before/after diff.
model MarketingSetting {
  id                     String   @id @default(cuid())
  storeId                String   @unique
  ga4MeasurementId       String?
  ga4MpEnabled           Boolean  @default(false)
  /// AES-256-GCM. Measurement Protocol API secret — server-side only, never rendered into storefront HTML.
  ga4ApiSecretCipher     String?
  /// Last four characters, so settings can prove which secret is stored.
  ga4ApiSecretHint       String?
  gtmContainerId         String?
  googleSiteVerification String?
  googleAdsConversionId  String?
  metaPixelId            String?
  metaDomainVerification String?
  metaCapiEnabled        Boolean  @default(false)
  /// AES-256-GCM. Server-side only — never rendered into storefront HTML.
  metaCapiTokenCipher    String?
  /// Last four characters, so settings can prove which token is stored.
  metaCapiTokenHint      String?
  tiktokPixelId          String?
  customEnabled          Boolean  @default(false)
  customHeaderCode       String?
  customBodyCode         String?
  customFooterCode       String?
  updatedById            String?
  store                  Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy              User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([storeId])
}

model PaymentMethod {
  id            String            @id @default(cuid())
  storeId       String
  type          PaymentMethodType
  name          String
  description   String?
  instructions  String?
  accountNumber String?
  accountType   String?
  isEnabled     Boolean           @default(false)
  sortOrder     Int               @default(0)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@unique([storeId, type])
  @@index([storeId])
}

model ShippingZone {
  id          String         @id @default(cuid())
  storeId     String
  name        String
  description String?
  isEnabled   Boolean        @default(true)
  sortOrder   Int            @default(0)
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates       ShippingRate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([storeId])
}

model ShippingRate {
  id        String       @id @default(cuid())
  storeId   String
  zoneId    String
  name      String
  district  String?
  city      String?
  area      String?
  amount    Decimal      @db.Decimal(12, 2)
  isEnabled Boolean      @default(true)
  sortOrder Int          @default(0)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([storeId])
  @@index([zoneId])
}

model StoreOSConnection {
  id                  String    @id @default(cuid())
  storeId             String    @unique
  storeosConnectionId String?   @unique
  platformType        String    @default("dash")
  status              String    @default("pending")
  capabilities        Json
  lastSyncedAt        DateTime?
  store               Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @default(now()) @updatedAt

  @@index([status])
}

model MediaAsset {
  id        String   @id @default(cuid())
  storeId   String
  url       String
  key       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String?
  usageType String?
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  isDemoContent Boolean @default(false)
  demoPackId    String?

  @@unique([storeId, key])
  @@index([storeId])
  @@index([usageType])
  @@index([storeId, isDemoContent])
}

model Product {
  id                  String                      @id @default(cuid())
  storeId             String
  categoryId          String?
  title               String
  slug                String
  description         String?
  shortDescription    String?
  sku                 String?
  price               Decimal                     @db.Decimal(12, 2)
  compareAtPrice      Decimal?                    @db.Decimal(12, 2)
  costPrice           Decimal?                    @db.Decimal(12, 2)
  stockQuantity       Int                         @default(0)
  lowStockThreshold   Int                         @default(0)
  status              ProductStatus               @default(DRAFT)
  visibility          ProductVisibility           @default(HIDDEN)
  isDemoContent       Boolean                     @default(false)
  demoPackId          String?
  store               Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category            Category?                   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images              ProductImage[]
  orderItems          OrderItem[]
  purchaseItems       PurchaseItem[]
  saleItems           SaleItem[]
  stockMovements      StockMovement[]
  taxonomyAssignments ProductTaxonomyAssignment[]
  categoryAssignments ProductCategoryAssignment[]
  attributes          ProductAttribute[]
  attributeValues     ProductAttributeValue[]
  variants            ProductVariant[]
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @default(now()) @updatedAt

  searchBoosts SearchBoost[]

  /// Storefront relevance index. Declared here only so `db:push` does not drop
  /// it; the real definition is the GENERATED ALWAYS expression in
  /// apps/web/src/modules/search/search-schema.ts, which Prisma cannot express.
  searchVector Unsupported("tsvector")?

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId])
  @@index([storeId, isDemoContent])
  @@index([storeId, demoPackId])
  @@index([categoryId])
  @@index([searchVector], type: Gin)
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Category {
  id                 String                      @id @default(cuid())
  storeId            String
  parentId           String?
  name               String
  slug               String
  description        String?
  imageUrl           String?
  isDemoContent      Boolean                     @default(false)
  demoPackId         String?
  store              Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent             Category?                   @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children           Category[]                  @relation("CategoryHierarchy")
  products           Product[]
  productAssignments ProductCategoryAssignment[]
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @default(now()) @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, isDemoContent])
  @@index([storeId, demoPackId])
  @@index([parentId])
}

// The six models below back tables that are also created at runtime by
// ensureProductTaxonomySchema() and ensureProductVariantSchema(). They mirror
// that DDL exactly — including `onUpdate: NoAction` (the raw DDL omits an
// ON UPDATE clause) and the custom index names — so `db push` stays a no-op.

model ProductTaxonomy {
  id            String                      @id @default(cuid())
  storeId       String
  type          String
  name          String
  slug          String
  imageUrl      String?
  isDemoContent Boolean                     @default(false)
  demoPackId    String?
  store         Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments   ProductTaxonomyAssignment[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @default(now()) @updatedAt

  @@unique([storeId, type, slug], map: "ProductTaxonomy_store_type_slug_key")
  @@index([storeId, type], map: "ProductTaxonomy_store_type_idx")
}

model ProductTaxonomyAssignment {
  id         String          @id @default(cuid())
  storeId    String
  productId  String
  taxonomyId String
  type       String
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taxonomy   ProductTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime        @default(now())

  @@unique([productId, taxonomyId, type], map: "ProductTaxonomyAssignment_product_taxonomy_type_key")
  @@index([storeId, productId], map: "ProductTaxonomyAssignment_store_product_idx")
}

model ProductCategoryAssignment {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  categoryId String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId], map: "ProductCategoryAssignment_product_category_key")
  @@index([storeId, productId], map: "ProductCategoryAssignment_store_product_idx")
}

model ProductAttribute {
  id        String                  @id @default(cuid())
  storeId   String
  productId String
  name      String
  position  Int                     @default(0)
  store     Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  values    ProductAttributeValue[]
  createdAt DateTime                @default(now())
