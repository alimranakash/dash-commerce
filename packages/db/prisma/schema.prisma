generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreDomainType {
  DASH_SUBDOMAIN
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVisibility {
  PUBLIC
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum PaymentMethodType {
  COD
  BKASH_MANUAL
  NAGAD_MANUAL
  ROCKET_MANUAL
}

enum OrderVerificationStatus {
  NORMAL
  QUEUED
  VERIFIED
  FAKE
}

enum CustomerFlagStatus {
  NORMAL
  WATCHLIST
  BLOCKED
}

enum FulfillmentStatus {
  UNFULFILLED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum ExpenseStatus {
  PAID
  PENDING
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  OTHER
}

enum SaleType {
  ONLINE
  OFFLINE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum SalePaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  BANK
  COD
  OTHER
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
  DAMAGE
  LOST
}

enum StockMovementSourceType {
  PURCHASE
  SALE
  MANUAL
  RETURN
  SYSTEM
}

model User {
  id          String               @id @default(cuid())
  name        String?
  email       String               @unique
  emailVerified DateTime?
  image       String?
  phone       String?
  language    String               @default("en")
  timezone    String               @default("Asia/Dhaka")
  dateFormat  String               @default("DD/MM/YYYY")
  isSuspended Boolean              @default(false)
  passwordHash String?
  role        UserRole             @default(MEMBER)
  accounts    Account[]
  sessions    Session[]
  memberships OrganizationMember[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  members   OrganizationMember[]
  stores    Store[]
  suppliers Supplier[]
  purchases Purchase[]
  expenseCategories ExpenseCategory[]
  expenses  Expense[]
  sales     Sale[]
  stockMovements StockMovement[]
  subscriptions Subscription[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Store {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String        @unique
  businessType   String        @default("general")
  status         StoreStatus   @default(DRAFT)
  currency       String        @default("USD")
  country        String        @default("US")
  timezone       String        @default("UTC")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains        StoreDomain[]
  products       Product[]
  categories     Category[]
  orders         Order[]
  customers      Customer[]
  addresses      Address[]
  setting        StoreSetting?
  themeSetting   ThemeSetting?
  paymentMethods PaymentMethod[]
  shippingZones  ShippingZone[]
  shippingRates  ShippingRate[]
  storeosConnection StoreOSConnection?
  mediaAssets    MediaAsset[]
  purchases      Purchase[]
  expenses       Expense[]
  sales          Sale[]
  stockMovements StockMovement[]
  subscription   Subscription?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([organizationId])
}

model StoreDomain {
  id         String          @id @default(cuid())
  storeId    String
  domain     String          @unique
  type       StoreDomainType
  isPrimary  Boolean         @default(false)
  verifiedAt DateTime?
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt

  @@index([storeId])
}

model StoreSetting {
  id              String   @id @default(cuid())
  storeId         String   @unique
  logoUrl         String?
  faviconUrl      String?
  contactEmail    String?
  contactPhone    String?
  supportPhone    String?
  businessAddress String?
  facebookUrl     String?
  instagramUrl    String?
  whatsappNumber  String?
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model ThemeSetting {
  id                   String   @id @default(cuid())
  storeId              String   @unique
  themeName            String   @default("Theme v1")
  primaryColor         String   @default("#135d66")
  secondaryColor       String?
  heroTitle            String   @default("Discover what is new")
  heroSubtitle         String?
  heroImageUrl         String?
  announcementText     String?
  featuredSectionTitle String   @default("Products worth a closer look")
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
}

model PaymentMethod {
  id            String            @id @default(cuid())
  storeId       String
  type          PaymentMethodType
  name          String
  description   String?
  instructions  String?
  accountNumber String?
  accountType   String?
  isEnabled     Boolean           @default(false)
  sortOrder     Int               @default(0)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@unique([storeId, type])
  @@index([storeId])
}

model ShippingZone {
  id          String         @id @default(cuid())
  storeId     String
  name        String
  description String?
  isEnabled   Boolean        @default(true)
  sortOrder   Int            @default(0)
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates       ShippingRate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([storeId])
}

model ShippingRate {
  id        String       @id @default(cuid())
  storeId   String
  zoneId    String
  name      String
  district  String?
  city      String?
  area      String?
  amount    Decimal      @db.Decimal(12, 2)
  isEnabled Boolean      @default(true)
  sortOrder Int          @default(0)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([storeId])
  @@index([zoneId])
}

model StoreOSConnection {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  storeosConnectionId String?  @unique
  platformType        String   @default("dash")
  status              String   @default("pending")
  capabilities        Json
  lastSyncedAt        DateTime?
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([status])
}

model MediaAsset {
  id        String   @id @default(cuid())
  storeId   String
  url       String
  key       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String?
  usageType String?
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  @@unique([storeId, key])
  @@index([storeId])
  @@index([usageType])
}

model Product {
  id                String            @id @default(cuid())
  storeId           String
  categoryId        String?
  title             String
  slug              String
  description       String?
  shortDescription  String?
  sku               String?
  price             Decimal           @db.Decimal(12, 2)
  compareAtPrice    Decimal?          @db.Decimal(12, 2)
  costPrice         Decimal?          @db.Decimal(12, 2)
  stockQuantity     Int               @default(0)
  lowStockThreshold Int               @default(0)
  status            ProductStatus     @default(DRAFT)
  visibility        ProductVisibility @default(HIDDEN)
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  orderItems        OrderItem[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  parentId    String?
  name        String
  slug        String
  description String?
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([parentId])
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  companyName    String?        @map("company_name")
  phone          String
  email          String?
  address        String?
  notes          String?
  status         SupplierStatus @default(ACTIVE)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  storeId        String         @map("store_id")
  supplierId     String         @map("supplier_id")
  purchaseNumber String         @map("purchase_number")
  status         PurchaseStatus @default(DRAFT)
  purchaseDate   DateTime       @map("purchase_date")
  subtotalAmount Decimal        @default(0) @db.Decimal(12, 2) @map("subtotal_amount")
  discountAmount Decimal        @default(0) @db.Decimal(12, 2) @map("discount_amount")
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2) @map("tax_amount")
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2) @map("total_amount")
  paidAmount     Decimal        @default(0) @db.Decimal(12, 2) @map("paid_amount")
  dueAmount      Decimal        @default(0) @db.Decimal(12, 2) @map("due_amount")
  notes          String?
  receivedAt     DateTime?      @map("received_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@unique([storeId, purchaseNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String    @map("purchase_id")
  productId   String?   @map("product_id")
  productName String    @map("product_name")
  sku         String?
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2) @map("unit_cost")
  totalCost   Decimal   @db.Decimal(12, 2) @map("total_cost")
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model ExpenseCategory {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  color          String       @default("#7C3AED")
  icon           String       @default("receipt")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("expense_categories")
}

model Expense {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  storeId        String               @map("store_id")
  categoryId     String               @map("category_id")
  expenseNumber  String               @map("expense_number")
  title          String
  amount         Decimal              @db.Decimal(12, 2)
  paymentMethod  ExpensePaymentMethod @map("payment_method")
  expenseDate    DateTime             @map("expense_date")
  reference      String?
  notes          String?
  attachmentUrl  String?              @map("attachment_url")
  status         ExpenseStatus        @default(PENDING)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")

  @@unique([storeId, expenseNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

model Sale {
  id            String            @id @default(cuid())
  organizationId String           @map("organization_id")
  storeId       String            @map("store_id")
  customerId    String?           @map("customer_id")
  saleNumber    String            @map("sale_number")
  saleType      SaleType          @default(OFFLINE) @map("sale_type")
  status        SaleStatus        @default(DRAFT)
  paymentStatus SalePaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod SalePaymentMethod @map("payment_method")
  saleDate      DateTime          @map("sale_date")
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  shipping      Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(12, 2) @map("paid_amount")
  dueAmount     Decimal           @default(0) @db.Decimal(12, 2) @map("due_amount")
  notes         String?
  completedAt   DateTime?         @map("completed_at")
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([storeId, saleNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([saleType])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id               String                  @id @default(cuid())
  organizationId   String                  @map("organization_id")
  storeId          String                  @map("store_id")
  productId        String                  @map("product_id")
  type             StockMovementType
  sourceType       StockMovementSourceType @map("source_type")
  sourceId         String?                 @map("source_id")
  quantityChange   Int                     @map("quantity_change")
  previousQuantity Int                     @map("previous_quantity")
  newQuantity      Int                     @map("new_quantity")
  reason           String
  notes            String?
  createdBy        String?                 @map("created_by")
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime                @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([storeId])
  @@index([productId])
  @@index([type])
  @@index([sourceType])
  @@index([createdAt])
  @@map("stock_movements")
}

model Plan {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  priceMonthly        Decimal  @default(0) @db.Decimal(12, 2) @map("price_monthly")
  priceYearly         Decimal  @default(0) @db.Decimal(12, 2) @map("price_yearly")
  currency            String   @default("BDT")
  trialDays           Int      @default(0) @map("trial_days")
  productLimit        Int      @default(0) @map("product_limit")
  orderLimit          Int      @default(0) @map("order_limit")
  staffLimit          Int      @default(1) @map("staff_limit")
  storeLimit          Int      @default(1) @map("store_limit")
  customDomainEnabled Boolean  @default(false) @map("custom_domain_enabled")
  aiEnabled           Boolean  @default(false) @map("ai_enabled")
  posEnabled          Boolean  @default(false) @map("pos_enabled")
  isActive            Boolean  @default(true) @map("is_active")
  isFeatured          Boolean  @default(false) @map("is_featured")
  sortOrder           Int      @default(0) @map("sort_order")
  subscriptions       Subscription[]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("plans")
}

model Subscription {
  id                  String             @id @default(cuid())
  organizationId      String             @map("organization_id")
  storeId             String             @unique @map("store_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(TRIALING)
  billingCycle        BillingCycle       @default(MONTHLY) @map("billing_cycle")
  trialStartsAt       DateTime?          @map("trial_starts_at")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodStartsAt DateTime?        @map("current_period_starts_at")
  currentPeriodEndsAt DateTime?          @map("current_period_ends_at")
  cancelAtPeriodEnd   Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt         DateTime?          @map("cancelled_at")
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store               Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id])
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@index([billingCycle])
  @@map("subscriptions")
}

model Customer {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  email     String?
  phone     String
  flagStatus CustomerFlagStatus @default(NORMAL)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]
  sales     Sale[]
  addresses Address[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([flagStatus])
}

model Address {
  id              String     @id @default(cuid())
  storeId         String
  customerId      String?
  name            String
  phone           String
  email           String?
  country         String
  district        String
  city            String?
  area            String?
  addressLine1    String
  addressLine2    String?
  postalCode      String?
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingOrders  Order[]    @relation("OrderShippingAddress")
  billingOrders   Order[]    @relation("OrderBillingAddress")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  @@index([storeId])
  @@index([customerId])
}

model Order {
  id                String            @id @default(cuid())
  storeId           String
  customerId        String?
  orderNumber       String
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  verificationStatus OrderVerificationStatus @default(NORMAL)
  paymentMethodType PaymentMethodType  @default(COD)
  paymentMethodName String             @default("Cash on delivery")
  paymentReference  String?
  paymentNote       String?
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String
  subtotalAmount    Decimal           @db.Decimal(12, 2)
  shippingAmount    Decimal           @default(0) @db.Decimal(12, 2)
  shippingRateId    String?
  shippingRateName  String?
  shippingDistrict  String?
  shippingCity      String?
  shippingArea      String?
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  customerName      String
  customerEmail     String?
  customerPhone     String
  shippingAddressId String?
  billingAddressId  String?
  notes             String?
  verifiedAt        DateTime?
  markedFakeAt      DateTime?
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress   Address?          @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    Address?          @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([verificationStatus])
  @@index([shippingAddressId])
  @@index([billingAddressId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  title     String
  sku       String?
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int
  total     Decimal  @db.Decimal(12, 2)
  imageUrl  String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
