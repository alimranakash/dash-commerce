/// The platform's own gateway credentials, editable from the admin panel.
///
/// A singleton, like `BillingSetting`: there is one SMS account and one mail
/// relay for the whole platform, not one per store. Secrets are encrypted with
/// the same key as courier credentials and never leave the server; the `*Hint`
/// columns hold the last few characters so an admin can tell which key is
/// loaded without the panel ever having to show it back.
///
/// Anything left blank falls back to the matching environment variable, so a
/// deployment that configured messaging through `.env` keeps working untouched
/// until someone saves a value here.
model MessagingSetting {
  id                 String   @id @default(cuid())
  smsEnabled         Boolean  @default(true) @map("sms_enabled")
  smsProvider        String   @default("alpha") @map("sms_provider")
  smsApiKeyCipher    String?  @map("sms_api_key_cipher")
  smsApiKeyHint      String?  @map("sms_api_key_hint")
  smsSenderId        String?  @map("sms_sender_id")
  emailEnabled       Boolean  @default(true) @map("email_enabled")
  smtpHost           String?  @map("smtp_host")
  smtpPort           Int?     @map("smtp_port")
  smtpUser           String?  @map("smtp_user")
  smtpPasswordCipher String?  @map("smtp_password_cipher")
  smtpPasswordHint   String?  @map("smtp_password_hint")
  smtpSecure         Boolean  @default(false) @map("smtp_secure")
  emailFrom          String?  @map("email_from")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("messaging_settings")
}

