  shipments             Shipment[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @default(now()) @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([verificationStatus])
  @@index([storeId, verificationStatus])
  @@index([storeId, riskLevel])
  @@index([storeId, riskAssessedAt])
