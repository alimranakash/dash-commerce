generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  OWNER
  ADMIN
  MEMBER
}

enum StoreStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  ARCHIVED
}

enum StoreDomainType {
  DASH_SUBDOMAIN
  CUSTOM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum SupportTicketStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED
}

enum SupportTicketPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum SupportTicketCategory {
  BILLING
  TECHNICAL
  STOREFRONT
  PAYMENTS
  COURIER
  ACCOUNT
  OTHER
}

enum SystemLogLevel {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum SystemLogSource {
  AUTH
  STORE
  BILLING
  PAYMENT
  SUBSCRIPTION
  SUPPORT
  ORDER
  PRODUCT
  SYSTEM
  API
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductVisibility {
  PUBLIC
  HIDDEN
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
  CANCELLED
}

enum PaymentGateway {
  SSLCOMMERZ
  STRIPE
  PADDLE
  MANUAL
  OTHER
}

enum PaymentMethodType {
  COD
  BKASH_MANUAL
  NAGAD_MANUAL
  ROCKET_MANUAL
}

enum OrderVerificationStatus {
  NORMAL
  QUEUED
  VERIFIED
  FAKE
}

enum CustomerFlagStatus {
  NORMAL
  WATCHLIST
  BLOCKED
}

enum FulfillmentStatus {
  UNFULFILLED
  SHIPPED
  PARTIALLY_FULFILLED
  FULFILLED
  RETURNED
}

enum ShipmentStatus {
  PENDING
  REQUESTED
  BOOKED
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  PARTIALLY_DELIVERED
  RETURNED
  CANCELLED
  HOLD
  LOST
  FAILED
  UNKNOWN
}

enum SupplierStatus {
  ACTIVE
  INACTIVE
}

enum PurchaseStatus {
  DRAFT
  ORDERED
  RECEIVED
  CANCELLED
}

enum ExpenseStatus {
  PAID
  PENDING
  CANCELLED
}

enum ExpensePaymentMethod {
  CASH
  BANK
  BKASH
  NAGAD
  CARD
  OTHER
}

enum SaleType {
  ONLINE
  OFFLINE
}

enum SaleStatus {
  DRAFT
  COMPLETED
  CANCELLED
  RETURNED
}

enum SalePaymentStatus {
  PAID
  PARTIAL
  UNPAID
}

enum SalePaymentMethod {
  CASH
  CARD
  BKASH
  NAGAD
  BANK
  COD
  OTHER
}

enum StockMovementType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
  RETURN
  DAMAGE
  LOST
}

enum StockMovementSourceType {
  PURCHASE
  SALE
  MANUAL
  RETURN
  SYSTEM
}

model User {
  id          String               @id @default(cuid())
  name        String?
  email       String               @unique
  emailVerified DateTime?
  image       String?
  phone       String?
  language    String               @default("en")
  timezone    String               @default("Asia/Dhaka")
  dateFormat  String               @default("DD/MM/YYYY")
  isSuspended Boolean              @default(false)
  passwordHash String?
  role        UserRole             @default(MEMBER)
  accounts    Account[]
  sessions    Session[]
  memberships OrganizationMember[]
  supportTickets SupportTicket[]    @relation("SupportTicketUser")
  assignedSupportTickets SupportTicket[] @relation("SupportTicketAssignee")
  supportTicketReplies SupportTicketReply[]
  systemLogs SystemLog[]
  marketingSettingUpdates MarketingSetting[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @default(now()) @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Organization {
  id        String               @id @default(cuid())
  name      String
  slug      String               @unique
  members   OrganizationMember[]
  stores    Store[]
  suppliers Supplier[]
  purchases Purchase[]
  expenseCategories ExpenseCategory[]
  expenses  Expense[]
  sales     Sale[]
  stockMovements StockMovement[]
  subscriptions Subscription[]
  payments  Payment[]
  supportTickets SupportTicket[]
  systemLogs SystemLog[]
  createdAt DateTime             @default(now())
  updatedAt DateTime             @default(now()) @updatedAt
}

model OrganizationMember {
  id             String       @id @default(cuid())
  userId         String
  organizationId String
  role           UserRole     @default(MEMBER)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @default(now()) @updatedAt

  @@unique([userId, organizationId])
  @@index([organizationId])
}

model Store {
  id             String        @id @default(cuid())
  organizationId String
  name           String
  slug           String        @unique
  businessType   String        @default("General Store")
  activeTemplate String        @default("general-default")
  activeDemoPack String        @default("general-demo-v1")
  demoPackInstalledAt DateTime?
  status         StoreStatus   @default(DRAFT)
  currency       String        @default("USD")
  country        String        @default("US")
  timezone       String        @default("UTC")
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  domains        StoreDomain[]
  products       Product[]
  categories     Category[]
  orders         Order[]
  customers      Customer[]
  addresses      Address[]
  setting        StoreSetting?
  themeSetting   ThemeSetting?
  marketingSetting MarketingSetting?
  paymentMethods PaymentMethod[]
  shippingZones  ShippingZone[]
  shippingRates  ShippingRate[]
  storeosConnection StoreOSConnection?
  mediaAssets    MediaAsset[]
  purchases      Purchase[]
  expenses       Expense[]
  sales          Sale[]
  stockMovements StockMovement[]
  subscription   Subscription?
  payments       Payment[]
  supportTickets SupportTicket[]
  systemLogs     SystemLog[]
  courierAccounts CourierAccount[]
  shipments      Shipment[]
  deliveryEvents DeliveryEvent[]
  courierCustomerScores CourierCustomerScore[]
  productTaxonomies          ProductTaxonomy[]
  productTaxonomyAssignments ProductTaxonomyAssignment[]
  productCategoryAssignments ProductCategoryAssignment[]
  productAttributes          ProductAttribute[]
  productAttributeValues     ProductAttributeValue[]
  productVariants            ProductVariant[]
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @default(now()) @updatedAt

  @@index([organizationId])
}

model StoreDomain {
  id         String          @id @default(cuid())
  storeId    String
  domain     String          @unique
  type       StoreDomainType
  isPrimary  Boolean         @default(false)
  verifiedAt DateTime?
  // Result of the last DNS check, so a seller still sees why a domain failed
  // after reloading the page. `lastCheckStatus` holds a DomainCheckStatus value.
  lastCheckedAt   DateTime?
  lastCheckStatus String?
  lastCheckDetail String?
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @default(now()) @updatedAt

  @@index([storeId])
}

model StoreSetting {
  id              String   @id @default(cuid())
  storeId         String   @unique
  logoUrl         String?
  faviconUrl      String?
  tagline         String?
  contactEmail    String?
  contactPhone    String?
  supportPhone    String?
  businessAddress String?
  facebookUrl     String?
  instagramUrl    String?
  whatsappNumber  String?
  moduleSettings  Json?
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
}

model ThemeSetting {
  id                   String   @id @default(cuid())
  storeId              String   @unique
  themeName            String   @default("Theme v1")
  primaryColor         String   @default("#135d66")
  secondaryColor       String?
  heroTitle            String   @default("Discover what is new")
  heroSubtitle         String?
  heroImageUrl         String?
  announcementText     String?
  featuredSectionTitle String   @default("Products worth a closer look")
  advancedSettings     Json?
  store                Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @default(now()) @updatedAt
}

/// Marketing / analytics configuration for one store.
///
/// Deliberately a table rather than a slice of `StoreSetting.moduleSettings`:
/// the Conversions API token is a secret (secrets never live in that JSON — see
/// CourierAccount), these columns are read on every storefront render, and
/// change logging wants a per-field before/after diff.
model MarketingSetting {
  id                     String   @id @default(cuid())
  storeId                String   @unique
  ga4MeasurementId       String?
  gtmContainerId         String?
  googleSiteVerification String?
  googleAdsConversionId  String?
  metaPixelId            String?
  metaDomainVerification String?
  metaCapiEnabled        Boolean  @default(false)
  /// AES-256-GCM. Server-side only — never rendered into storefront HTML.
  metaCapiTokenCipher    String?
  /// Last four characters, so settings can prove which token is stored.
  metaCapiTokenHint      String?
  tiktokPixelId          String?
  customEnabled          Boolean  @default(false)
  customHeaderCode       String?
  customBodyCode         String?
  customFooterCode       String?
  updatedById            String?
  store                  Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  updatedBy              User?    @relation(fields: [updatedById], references: [id], onDelete: SetNull)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @default(now()) @updatedAt

  @@index([storeId])
}

model PaymentMethod {
  id            String            @id @default(cuid())
  storeId       String
  type          PaymentMethodType
  name          String
  description   String?
  instructions  String?
  accountNumber String?
  accountType   String?
  isEnabled     Boolean           @default(false)
  sortOrder     Int               @default(0)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @default(now()) @updatedAt

  @@unique([storeId, type])
  @@index([storeId])
}

model ShippingZone {
  id          String         @id @default(cuid())
  storeId     String
  name        String
  description String?
  isEnabled   Boolean        @default(true)
  sortOrder   Int            @default(0)
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  rates       ShippingRate[]
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @default(now()) @updatedAt

  @@index([storeId])
}

model ShippingRate {
  id        String       @id @default(cuid())
  storeId   String
  zoneId    String
  name      String
  district  String?
  city      String?
  area      String?
  amount    Decimal      @db.Decimal(12, 2)
  isEnabled Boolean      @default(true)
  sortOrder Int          @default(0)
  store     Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  zone      ShippingZone @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @default(now()) @updatedAt

  @@index([storeId])
  @@index([zoneId])
}

model StoreOSConnection {
  id                  String   @id @default(cuid())
  storeId             String   @unique
  storeosConnectionId String?  @unique
  platformType        String   @default("dash")
  status              String   @default("pending")
  capabilities        Json
  lastSyncedAt        DateTime?
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @default(now()) @updatedAt

  @@index([status])
}

model MediaAsset {
  id        String   @id @default(cuid())
  storeId   String
  url       String
  key       String
  filename  String
  mimeType  String
  size      Int
  width     Int?
  height    Int?
  alt       String?
  usageType String?
  store     Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @default(now()) @updatedAt

  isDemoContent Boolean @default(false)
  demoPackId    String?

  @@unique([storeId, key])
  @@index([storeId])
  @@index([usageType])
  @@index([storeId, isDemoContent])
}

model Product {
  id                String            @id @default(cuid())
  storeId           String
  categoryId        String?
  title             String
  slug              String
  description       String?
  shortDescription  String?
  sku               String?
  price             Decimal           @db.Decimal(12, 2)
  compareAtPrice    Decimal?          @db.Decimal(12, 2)
  costPrice         Decimal?          @db.Decimal(12, 2)
  stockQuantity     Int               @default(0)
  lowStockThreshold Int               @default(0)
  status            ProductStatus     @default(DRAFT)
  visibility        ProductVisibility @default(HIDDEN)
  isDemoContent     Boolean           @default(false)
  demoPackId        String?
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category          Category?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  images            ProductImage[]
  orderItems        OrderItem[]
  purchaseItems     PurchaseItem[]
  saleItems         SaleItem[]
  stockMovements    StockMovement[]
  taxonomyAssignments ProductTaxonomyAssignment[]
  categoryAssignments ProductCategoryAssignment[]
  attributes          ProductAttribute[]
  attributeValues     ProductAttributeValue[]
  variants            ProductVariant[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@unique([storeId, slug])
  @@unique([storeId, sku])
  @@index([storeId])
  @@index([storeId, isDemoContent])
  @@index([storeId, demoPackId])
  @@index([categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  url       String
  alt       String?
  position  Int      @default(0)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
}

model Category {
  id          String     @id @default(cuid())
  storeId     String
  parentId    String?
  name        String
  slug        String
  description String?
  imageUrl    String?
  isDemoContent Boolean   @default(false)
  demoPackId    String?
  store       Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  parent      Category?  @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    Category[] @relation("CategoryHierarchy")
  products    Product[]
  productAssignments ProductCategoryAssignment[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @default(now()) @updatedAt

  @@unique([storeId, slug])
  @@index([storeId])
  @@index([storeId, isDemoContent])
  @@index([storeId, demoPackId])
  @@index([parentId])
}

// The six models below back tables that are also created at runtime by
// ensureProductTaxonomySchema() and ensureProductVariantSchema(). They mirror
// that DDL exactly — including `onUpdate: NoAction` (the raw DDL omits an
// ON UPDATE clause) and the custom index names — so `db push` stays a no-op.

model ProductTaxonomy {
  id            String                      @id @default(cuid())
  storeId       String
  type          String
  name          String
  slug          String
  imageUrl      String?
  isDemoContent Boolean                     @default(false)
  demoPackId    String?
  store         Store                       @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  assignments   ProductTaxonomyAssignment[]
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @default(now()) @updatedAt

  @@unique([storeId, type, slug], map: "ProductTaxonomy_store_type_slug_key")
  @@index([storeId, type], map: "ProductTaxonomy_store_type_idx")
}

model ProductTaxonomyAssignment {
  id         String          @id @default(cuid())
  storeId    String
  productId  String
  taxonomyId String
  type       String
  store      Store           @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  taxonomy   ProductTaxonomy @relation(fields: [taxonomyId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime        @default(now())

  @@unique([productId, taxonomyId, type], map: "ProductTaxonomyAssignment_product_taxonomy_type_key")
  @@index([storeId, productId], map: "ProductTaxonomyAssignment_store_product_idx")
}

model ProductCategoryAssignment {
  id         String   @id @default(cuid())
  storeId    String
  productId  String
  categoryId String
  store      Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt  DateTime @default(now())

  @@unique([productId, categoryId], map: "ProductCategoryAssignment_product_category_key")
  @@index([storeId, productId], map: "ProductCategoryAssignment_store_product_idx")
}

model ProductAttribute {
  id        String                  @id @default(cuid())
  storeId   String
  productId String
  name      String
  position  Int                     @default(0)
  store     Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product   Product                 @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  values    ProductAttributeValue[]
  createdAt DateTime                @default(now())
  updatedAt DateTime                @default(now()) @updatedAt

  @@index([storeId, productId], map: "ProductAttribute_store_product_idx")
}

model ProductAttributeValue {
  id          String           @id @default(cuid())
  storeId     String
  productId   String
  attributeId String
  name        String
  position    Int              @default(0)
  store       Store            @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product     Product          @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  attribute   ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @default(now()) @updatedAt

  @@index([storeId, productId], map: "ProductAttributeValue_store_product_idx")
}

model ProductVariant {
  id                String   @id @default(cuid())
  storeId           String
  productId         String
  title             String
  optionSignature   String
  options           Json     @default("{}")
  sku               String?
  imageUrl          String?
  price             Decimal  @default(0) @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  stockQuantity     Int      @default(0)
  lowStockThreshold Int      @default(0)
  continueSelling   Boolean  @default(false)
  status            String   @default("ACTIVE")
  position          Int      @default(0)
  barcode           String?
  weight            String?
  dimensions        String?
  taxClass          String?
  shippingClass     String?
  store             Store    @relation(fields: [storeId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @default(now()) @updatedAt

  @@unique([productId, optionSignature], map: "ProductVariant_product_signature_key")
  @@index([storeId, productId], map: "ProductVariant_store_product_idx")
}

model Supplier {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  name           String
  companyName    String?        @map("company_name")
  phone          String
  email          String?
  address        String?
  notes          String?
  status         SupplierStatus @default(ACTIVE)
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchases      Purchase[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([status])
  @@map("suppliers")
}

model Purchase {
  id             String         @id @default(cuid())
  organizationId String         @map("organization_id")
  storeId        String         @map("store_id")
  supplierId     String         @map("supplier_id")
  purchaseNumber String         @map("purchase_number")
  status         PurchaseStatus @default(DRAFT)
  purchaseDate   DateTime       @map("purchase_date")
  subtotalAmount Decimal        @default(0) @db.Decimal(12, 2) @map("subtotal_amount")
  discountAmount Decimal        @default(0) @db.Decimal(12, 2) @map("discount_amount")
  taxAmount      Decimal        @default(0) @db.Decimal(12, 2) @map("tax_amount")
  totalAmount    Decimal        @default(0) @db.Decimal(12, 2) @map("total_amount")
  paidAmount     Decimal        @default(0) @db.Decimal(12, 2) @map("paid_amount")
  dueAmount      Decimal        @default(0) @db.Decimal(12, 2) @map("due_amount")
  notes          String?
  receivedAt     DateTime?      @map("received_at")
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  supplier       Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  items          PurchaseItem[]
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @default(now()) @updatedAt @map("updated_at")

  @@unique([storeId, purchaseNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([supplierId])
  @@index([status])
  @@map("purchases")
}

model PurchaseItem {
  id          String    @id @default(cuid())
  purchaseId  String    @map("purchase_id")
  productId   String?   @map("product_id")
  productName String    @map("product_name")
  sku         String?
  quantity    Int
  unitCost    Decimal   @db.Decimal(12, 2) @map("unit_cost")
  totalCost   Decimal   @db.Decimal(12, 2) @map("total_cost")
  purchase    Purchase  @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product     Product?  @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([purchaseId])
  @@index([productId])
  @@map("purchase_items")
}

model ExpenseCategory {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  color          String       @default("#7C3AED")
  icon           String       @default("receipt")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenses       Expense[]
  createdAt      DateTime     @default(now()) @map("created_at")

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("expense_categories")
}

model Expense {
  id             String               @id @default(cuid())
  organizationId String               @map("organization_id")
  storeId        String               @map("store_id")
  categoryId     String               @map("category_id")
  expenseNumber  String               @map("expense_number")
  title          String
  amount         Decimal              @db.Decimal(12, 2)
  paymentMethod  ExpensePaymentMethod @map("payment_method")
  expenseDate    DateTime             @map("expense_date")
  reference      String?
  notes          String?
  attachmentUrl  String?              @map("attachment_url")
  status         ExpenseStatus        @default(PENDING)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store          Store                @relation(fields: [storeId], references: [id], onDelete: Cascade)
  category       ExpenseCategory      @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @default(now()) @updatedAt @map("updated_at")

  @@unique([storeId, expenseNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([categoryId])
  @@index([status])
  @@index([expenseDate])
  @@map("expenses")
}

model Sale {
  id            String            @id @default(cuid())
  organizationId String           @map("organization_id")
  storeId       String            @map("store_id")
  customerId    String?           @map("customer_id")
  saleNumber    String            @map("sale_number")
  saleType      SaleType          @default(OFFLINE) @map("sale_type")
  status        SaleStatus        @default(DRAFT)
  paymentStatus SalePaymentStatus @default(UNPAID) @map("payment_status")
  paymentMethod SalePaymentMethod @map("payment_method")
  saleDate      DateTime          @map("sale_date")
  subtotal      Decimal           @default(0) @db.Decimal(12, 2)
  discount      Decimal           @default(0) @db.Decimal(12, 2)
  tax           Decimal           @default(0) @db.Decimal(12, 2)
  shipping      Decimal           @default(0) @db.Decimal(12, 2)
  total         Decimal           @default(0) @db.Decimal(12, 2)
  paidAmount    Decimal           @default(0) @db.Decimal(12, 2) @map("paid_amount")
  dueAmount     Decimal           @default(0) @db.Decimal(12, 2) @map("due_amount")
  notes         String?
  completedAt   DateTime?         @map("completed_at")
  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store         Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer      Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items         SaleItem[]
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at")

  @@unique([storeId, saleNumber])
  @@index([organizationId])
  @@index([storeId])
  @@index([customerId])
  @@index([status])
  @@index([saleType])
  @@index([saleDate])
  @@map("sales")
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String   @map("sale_id")
  productId   String   @map("product_id")
  productName String   @map("product_name")
  sku         String?
  quantity    Int
  unitPrice   Decimal  @db.Decimal(12, 2) @map("unit_price")
  discount    Decimal  @default(0) @db.Decimal(12, 2)
  total       Decimal  @db.Decimal(12, 2)
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product     Product  @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([saleId])
  @@index([productId])
  @@map("sale_items")
}

model StockMovement {
  id               String                  @id @default(cuid())
  organizationId   String                  @map("organization_id")
  storeId          String                  @map("store_id")
  productId        String                  @map("product_id")
  type             StockMovementType
  sourceType       StockMovementSourceType @map("source_type")
  sourceId         String?                 @map("source_id")
  quantityChange   Int                     @map("quantity_change")
  previousQuantity Int                     @map("previous_quantity")
  newQuantity      Int                     @map("new_quantity")
  reason           String
  notes            String?
  createdBy        String?                 @map("created_by")
  organization     Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store            Store                   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  product          Product                 @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt        DateTime                @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([storeId])
  @@index([productId])
  @@index([type])
  @@index([sourceType])
  @@index([createdAt])
  @@map("stock_movements")
}

model Plan {
  id                  String   @id @default(cuid())
  name                String
  slug                String   @unique
  description         String?
  priceMonthly        Decimal  @default(0) @db.Decimal(12, 2) @map("price_monthly")
  priceYearly         Decimal  @default(0) @db.Decimal(12, 2) @map("price_yearly")
  currency            String   @default("BDT")
  trialDays           Int      @default(0) @map("trial_days")
  productLimit        Int      @default(0) @map("product_limit")
  orderLimit          Int      @default(0) @map("order_limit")
  staffLimit          Int      @default(1) @map("staff_limit")
  storeLimit          Int      @default(1) @map("store_limit")
  customDomainEnabled Boolean  @default(false) @map("custom_domain_enabled")
  aiEnabled           Boolean  @default(false) @map("ai_enabled")
  posEnabled          Boolean  @default(false) @map("pos_enabled")
  isActive            Boolean  @default(true) @map("is_active")
  isFeatured          Boolean  @default(false) @map("is_featured")
  sortOrder           Int      @default(0) @map("sort_order")
  subscriptions       Subscription[]
  createdAt           DateTime @default(now()) @map("created_at")
  updatedAt           DateTime @default(now()) @updatedAt @map("updated_at")

  @@index([isActive])
  @@index([isFeatured])
  @@index([sortOrder])
  @@map("plans")
}

model Subscription {
  id                  String             @id @default(cuid())
  organizationId      String             @map("organization_id")
  storeId             String             @unique @map("store_id")
  planId              String             @map("plan_id")
  status              SubscriptionStatus @default(TRIALING)
  billingCycle        BillingCycle       @default(MONTHLY) @map("billing_cycle")
  trialStartsAt       DateTime?          @map("trial_starts_at")
  trialEndsAt         DateTime?          @map("trial_ends_at")
  currentPeriodStartsAt DateTime?        @map("current_period_starts_at")
  currentPeriodEndsAt DateTime?          @map("current_period_ends_at")
  cancelAtPeriodEnd   Boolean            @default(false) @map("cancel_at_period_end")
  cancelledAt         DateTime?          @map("cancelled_at")
  organization        Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store               Store              @relation(fields: [storeId], references: [id], onDelete: Cascade)
  plan                Plan               @relation(fields: [planId], references: [id])
  payments            Payment[]
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @default(now()) @updatedAt @map("updated_at")

  @@index([organizationId])
  @@index([planId])
  @@index([status])
  @@index([billingCycle])
  @@map("subscriptions")
}

model Payment {
  id               String         @id @default(cuid())
  subscriptionId   String         @map("subscription_id")
  organizationId   String         @map("organization_id")
  storeId          String         @map("store_id")
  invoiceNumber    String         @unique @map("invoice_number")
  paymentReference String?        @map("payment_reference")
  senderNumber     String?        @map("sender_number")
  paymentNote      String?        @map("payment_note")
  rejectionReason  String?        @map("rejection_reason")
  gateway          PaymentGateway @default(MANUAL)
  currency         String         @default("BDT")
  amount           Decimal        @db.Decimal(12, 2)
  status           PaymentStatus  @default(PENDING)
  paymentMethod    String         @default("Manual") @map("payment_method")
  paidAt           DateTime?      @map("paid_at")
  subscription     Subscription   @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  store            Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt        DateTime       @default(now()) @map("created_at")
  updatedAt        DateTime       @default(now()) @updatedAt @map("updated_at")

  @@index([subscriptionId])
  @@index([organizationId])
  @@index([storeId])
  @@index([status])
  @@index([gateway])
  @@index([paidAt])
  @@map("payments")
}

model BillingSetting {
  id                  String   @id @default(cuid())
  bkashNumber          String?  @map("bkash_number")
  bkashAccountType     String?  @map("bkash_account_type")
  nagadNumber          String?  @map("nagad_number")
  nagadAccountType     String?  @map("nagad_account_type")
  rocketNumber         String?  @map("rocket_number")
  rocketAccountType    String?  @map("rocket_account_type")
  bankAccountDetails   String?  @map("bank_account_details")
  paymentInstructions  String?  @map("payment_instructions")
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("billing_settings")
}

model SupportTicket {
  id             String                @id @default(cuid())
  userId         String                @map("user_id")
  organizationId String?               @map("organization_id")
  storeId        String?               @map("store_id")
  subject        String
  message        String
  status         SupportTicketStatus   @default(OPEN)
  priority       SupportTicketPriority @default(MEDIUM)
  category       SupportTicketCategory @default(OTHER)
  assignedTo     String?               @map("assigned_to")
  user           User                  @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization?         @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  store          Store?                @relation(fields: [storeId], references: [id], onDelete: SetNull)
  assignee       User?                 @relation("SupportTicketAssignee", fields: [assignedTo], references: [id], onDelete: SetNull)
  replies        SupportTicketReply[]
  createdAt      DateTime              @default(now()) @map("created_at")
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at")
  closedAt       DateTime?             @map("closed_at")

  @@index([userId])
  @@index([organizationId])
  @@index([storeId])
  @@index([assignedTo])
  @@index([status])
  @@index([priority])
  @@index([category])
  @@map("support_tickets")
}

model SupportTicketReply {
  id           String        @id @default(cuid())
  ticketId     String        @map("ticket_id")
  userId       String        @map("user_id")
  message      String
  isAdminReply Boolean       @default(false) @map("is_admin_reply")
  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([ticketId])
  @@index([userId])
  @@map("support_ticket_replies")
}

model SystemLog {
  id             String          @id @default(cuid())
  level          SystemLogLevel
  source         SystemLogSource
  message        String
  metadata       Json?
  userId         String?         @map("user_id")
  organizationId String?         @map("organization_id")
  storeId        String?         @map("store_id")
  user           User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  store          Store?          @relation(fields: [storeId], references: [id], onDelete: SetNull)
  createdAt      DateTime        @default(now()) @map("created_at")

  @@index([level])
  @@index([source])
  @@index([userId])
  @@index([organizationId])
  @@index([storeId])
  @@index([createdAt])
  @@map("system_logs")
}

model Customer {
  id        String    @id @default(cuid())
  storeId   String
  name      String
  email     String?
  phone     String
  flagStatus CustomerFlagStatus @default(NORMAL)
  store     Store     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orders    Order[]
  sales     Sale[]
  addresses Address[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @default(now()) @updatedAt

  @@unique([storeId, phone])
  @@index([storeId])
  @@index([flagStatus])
}

model Address {
  id              String     @id @default(cuid())
  storeId         String
  customerId      String?
  name            String
  phone           String
  email           String?
  country         String
  district        String
  city            String?
  area            String?
  addressLine1    String
  addressLine2    String?
  postalCode      String?
  store           Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer        Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingOrders  Order[]    @relation("OrderShippingAddress")
  billingOrders   Order[]    @relation("OrderBillingAddress")
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @default(now()) @updatedAt

  @@index([storeId])
  @@index([customerId])
}

model Order {
  id                String            @id @default(cuid())
  storeId           String
  customerId        String?
  orderNumber       String
  status            OrderStatus       @default(PENDING)
  paymentStatus     PaymentStatus     @default(PENDING)
  verificationStatus OrderVerificationStatus @default(NORMAL)
  paymentMethodType PaymentMethodType  @default(COD)
  paymentMethodName String             @default("Cash on delivery")
  paymentReference  String?
  paymentNote       String?
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED)
  currency          String
  subtotalAmount    Decimal           @db.Decimal(12, 2)
  shippingAmount    Decimal           @default(0) @db.Decimal(12, 2)
  shippingRateId    String?
  shippingRateName  String?
  shippingDistrict  String?
  shippingCity      String?
  shippingArea      String?
  discountAmount    Decimal           @default(0) @db.Decimal(12, 2)
  taxAmount         Decimal           @default(0) @db.Decimal(12, 2)
  totalAmount       Decimal           @db.Decimal(12, 2)
  customerName      String
  customerEmail     String?
  customerPhone     String
  shippingAddressId String?
  billingAddressId  String?
  notes             String?
  verifiedAt        DateTime?
  markedFakeAt      DateTime?
  store             Store             @relation(fields: [storeId], references: [id], onDelete: Cascade)
  customer          Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress   Address?          @relation("OrderShippingAddress", fields: [shippingAddressId], references: [id], onDelete: SetNull)
  billingAddress    Address?          @relation("OrderBillingAddress", fields: [billingAddressId], references: [id], onDelete: SetNull)
  items             OrderItem[]
  shipments         Shipment[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @default(now()) @updatedAt

  @@unique([storeId, orderNumber])
  @@index([storeId])
  @@index([customerId])
  @@index([verificationStatus])
  @@index([shippingAddressId])
  @@index([billingAddressId])
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String?
  title     String
  sku       String?
  price     Decimal  @db.Decimal(12, 2)
  quantity  Int
  total     Decimal  @db.Decimal(12, 2)
  imageUrl  String?
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}

model CourierAccount {
  id                String     @id @default(cuid())
  storeId           String
  provider          String
  label             String?
  isEnabled         Boolean    @default(true)
  isDefault         Boolean    @default(false)
  credentialsCipher String?
  credentialsPublic Json?
  secretHint        String?
  metadata          Json?
  lastTestedAt      DateTime?
  lastTestStatus    String?
  lastTestMessage   String?
  balanceAmount     Decimal?   @db.Decimal(12, 2)
  balanceCheckedAt  DateTime?
  store             Store      @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipments         Shipment[]
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @default(now()) @updatedAt

  @@unique([storeId, provider])
  @@index([storeId])
}

model Shipment {
  id                 String          @id @default(cuid())
  storeId            String
  orderId            String
  provider           String
  courierAccountId   String?
  status             ShipmentStatus  @default(PENDING)
  providerStatus     String?
  providerShipmentId String?
  trackingCode       String?
  invoiceReference   String
  codAmount          Decimal         @default(0) @db.Decimal(12, 2)
  labelUrl           String?
  requestHash        String?
  attemptCount       Int             @default(0)
  lastError          String?
  lastSyncedAt       DateTime?
  bookedAt           DateTime?
  deliveredAt        DateTime?
  cancelledAt        DateTime?
  rawResponse        Json?
  createdByUserId    String?
  store              Store           @relation(fields: [storeId], references: [id], onDelete: Cascade)
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  courierAccount     CourierAccount? @relation(fields: [courierAccountId], references: [id], onDelete: SetNull)
  events             DeliveryEvent[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @default(now()) @updatedAt

  @@unique([storeId, orderId, provider])
  @@unique([storeId, provider, invoiceReference])
  @@index([storeId, status])
  @@index([orderId])
  @@index([trackingCode])
  @@index([courierAccountId])
  @@index([storeId, invoiceReference])
  @@index([provider, providerShipmentId])
}

model DeliveryEvent {
  id             String         @id @default(cuid())
  storeId        String
  shipmentId     String
  status         ShipmentStatus
  providerStatus String?
  message        String?
  source         String         @default("SYSTEM")
  occurredAt     DateTime       @default(now())
  payload        Json?
  store          Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  shipment       Shipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())

  @@index([shipmentId, occurredAt])
  @@index([storeId])
}

model CourierCustomerScore {
  id             String   @id @default(cuid())
  storeId        String
  provider       String
  phone          String
  totalParcels   Int      @default(0)
  totalDelivered Int      @default(0)
  totalCancelled Int      @default(0)
  successRatio   Decimal? @db.Decimal(5, 2)
  raw            Json?
  checkedAt      DateTime @default(now())
  store          Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now()) @updatedAt

  @@unique([storeId, provider, phone])
  @@index([storeId])
}
