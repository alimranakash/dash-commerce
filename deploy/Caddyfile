# StoreIM — Caddy reverse proxy with on-demand TLS for seller domains.
#
# Replace storeim.com with the real PLATFORM_ROOT_DOMAIN and admin@storeim.com
# with a real address. Everything else works as written.
#
# Install to /etc/caddy/Caddyfile, then:  caddy validate --config /etc/caddy/Caddyfile
#                                        systemctl reload caddy

{
	# Let's Encrypt sends expiry notices here.
	email admin@storeim.com

	# Testing? Uncomment this to use the staging CA, whose limits are far higher and
	# whose certificates are untrusted (browsers will warn — that is expected).
	# acme_ca https://acme-staging-v02.api.letsencrypt.org/directory

	on_demand_tls {
		# The app decides which hostnames may get a certificate. 2xx = issue.
		# Drop ?token=... if DOMAIN_AUTHORIZE_TOKEN is unset in the app's .env.
		ask http://127.0.0.1:3000/api/domains/authorize?token=REPLACE_WITH_DOMAIN_AUTHORIZE_TOKEN
	}
}

(app) {
	encode zstd gzip

	# The app reads the Host header to pick the tenant, and x-forwarded-proto to
	# build redirects. Caddy passes both through by default.
	reverse_proxy 127.0.0.1:3000

	# Caddy reaches the authorisation endpoint directly on 127.0.0.1, so it never
	# needs to be answerable from the outside. The campaign scheduler is the same
	# shape: a local timer calls it, and nothing on the internet should be able to
	# make this server start sending SMS. See deploy/campaign-scheduler.md.
	@internal path /api/domains/authorize* /api/cron/*
	handle @internal {
		respond "not found" 404
	}
}

# --- The platform's own hostnames -------------------------------------------
# Named sites, so Caddy gets these certificates at startup instead of waiting for
# a handshake.
storeim.com, www.storeim.com, app.storeim.com {
	import app
}

# --- Tenant subdomains and seller custom domains -----------------------------
# Any other hostname that arrives on 443: issued on demand, only if the app
# authorises it. That covers both <slug>.storeim.com and seller custom domains.
#
# Note: every <slug>.storeim.com certificate counts against the same "50
# certificates per registered domain per week" bucket for storeim.com. Past ~50
# new stores a week, switch the tenant subdomains to a single wildcard
# certificate. That needs a DNS-01 challenge, so a Caddy build with the
# Cloudflare plugin and a token that can edit the zone:
#
#   caddy add-package github.com/caddy-dns/cloudflare
#   systemctl edit caddy   ->  [Service]
#                              Environment=CLOUDFLARE_API_TOKEN=...
#
#   *.storeim.com {
#       tls {
#           dns cloudflare {env.CLOUDFLARE_API_TOKEN}
#       }
#       import app
#   }
#
# Seller custom domains are each their own registered domain, so they have their
# own bucket and are unaffected either way.
https:// {
	tls {
		on_demand
	}

	import app
}

# Plain HTTP on any hostname: redirect to HTTPS. Caddy answers ACME HTTP-01
# challenges on port 80 ahead of this route, so issuance still works.
http:// {
	redir https://{host}{uri} permanent
}
