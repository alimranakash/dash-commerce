DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STOREOS_API_URL=
STOREOS_API_KEY=
# 32-byte base64 key encrypting courier API credentials at rest.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
COURIER_CREDENTIALS_KEY=
# The platform's own hostnames. Defaults to dash.com / app.dash.com, which is
# fine locally but must be set to the real domain on a deployed server — request
# routing, new stores' subdomains, and TLS authorisation all read these.
PLATFORM_ROOT_DOMAIN=
PLATFORM_APP_HOST=
# Shared secret for /api/domains/authorize, the endpoint Caddy's on_demand_tls
# `ask` calls. Optional but recommended; generate with:
# node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
DOMAIN_AUTHORIZE_TOKEN=
# Where sellers point their custom domains, and what domain verification checks
# against. IPV4 is this server's public address (comma-separate several); CNAME is
# optional and is offered to subdomains so the IP can change without sellers
# editing DNS. Without at least one of these, the Domains settings page cannot
# show records or verify anything.
PLATFORM_DOMAIN_IPV4=
PLATFORM_DOMAIN_IPV6=
PLATFORM_DOMAIN_CNAME=
STORAGE_DRIVER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
