DATABASE_URL=
NEXTAUTH_SECRET=
NEXTAUTH_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
STOREOS_API_URL=
STOREOS_API_KEY=
# Optional pepper for one-time verification codes. Falls back to NEXTAUTH_SECRET
# when unset; changing either only invalidates codes already in flight.
OTP_SECRET=
# Outbound email. Any SMTP relay works; leave unset and verification codes are
# written to the server log instead of sent. Publish SPF and DKIM for the
# sending domain or the mail will land in spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# Leave blank to authenticate over STARTTLS; port 465 turns this on by itself.
SMTP_SECURE=
# Defaults to SMTP_USER, which is what most relays require anyway.
EMAIL_FROM=
# Outbound SMS through api.sms.net.bd. Unset behaves like email: logged, not sent.
# A new Alpha SMS account can only message its own registered number until the
# first balance recharge, so testing any other number needs credit on it first.
SMS_PROVIDER=alpha
ALPHA_SMS_API_KEY=
# Only works once the gateway has approved the sender ID; sends go out unbranded
# without it, and a rejected ID falls back to unbranded automatically.
SMS_SENDER_ID=
# 32-byte base64 key encrypting courier API credentials at rest.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
COURIER_CREDENTIALS_KEY=
# The platform's own hostnames. Defaults to dash.com / app.dash.com, which is
# fine locally but must be set to the real domain on a deployed server — request
# routing, new stores' subdomains, and TLS authorisation all read these.
PLATFORM_ROOT_DOMAIN=
PLATFORM_APP_HOST=
# Shared secret for /api/domains/authorize, the endpoint Caddy's on_demand_tls
# `ask` calls. Optional but recommended; generate with:
# node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
DOMAIN_AUTHORIZE_TOKEN=
# Where sellers point their custom domains, and what domain verification checks
# against. IPV4 is this server's public address (comma-separate several); CNAME is
# optional and is offered to subdomains so the IP can change without sellers
# editing DNS. Without at least one of these, the Domains settings page cannot
# show records or verify anything.
PLATFORM_DOMAIN_IPV4=
PLATFORM_DOMAIN_IPV6=
PLATFORM_DOMAIN_CNAME=
STORAGE_DRIVER=
STORAGE_BUCKET=
STORAGE_REGION=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_PUBLIC_URL=
